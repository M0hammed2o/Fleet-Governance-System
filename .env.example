# Names and documentation only. Copy to an untracked .env for local work and
# obtain all production values from the approved secret/configuration manager.
# Never commit populated values.

# Runtime identity and externally visible HTTPS origin.
APP_ENV=
APP_BASE_URL=
AUTH_TRUSTED_ORIGINS=

# Managed PostgreSQL: pooled runtime URL and direct migration URL.
DATABASE_URL=
DIRECT_DATABASE_URL=
DATABASE_SSL_MODE=
DATABASE_MAX_CONNECTIONS=
DATABASE_CONNECTION_TIMEOUT_MS=
DATABASE_QUERY_TIMEOUT_MS=
DATABASE_TRANSACTION_TIMEOUT_MS=

# Current and previous values permit controlled key rotation.
SESSION_SECRET=
SESSION_SECRET_PREVIOUS=
MEDIA_URL_SIGNING_SECRET=
MEDIA_URL_SIGNING_SECRET_PREVIOUS=
BIOMETRIC_TEMPLATE_ENCRYPTION_KEY=
JOB_SCHEDULER_TOKEN=
JOB_SCHEDULER_TOKEN_PREVIOUS=

# Storage: local is development/test only; r2 is the existing S3-compatible
# boundary and still requires an approved private bucket/account.
STORAGE_PROVIDER=
STORAGE_LOCAL_PATH=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Providers remain disabled/no-op/mock until explicitly approved. Production
# validation rejects mock and dev-console choices.
PAYMENT_PROVIDER=
BILLING_EMAIL_PROVIDER=
INVESTIGATION_NOTIFICATION_PROVIDER=
AUDITOR_INVITATION_PROVIDER=
RETENTION_NOTIFICATION_PROVIDER=
TELEMATICS_PROVIDER=
MONITORING_PROVIDER=
EMAIL_REQUIRED=
PAYMENTS_REQUIRED=
TRACKER_REQUIRED=

# Manual production/pilot readiness confirmations (never credentials).
DEPLOYMENT_TARGET=
BACKUP_STRATEGY=
BACKUP_LAST_RESTORE_TEST_AT=
INFORMATION_OFFICER_CONFIRMED=
PAIA_MANUAL_CONFIRMED=
PILOT_APPROVED=
PILOT_SUPPORT_OWNER=
