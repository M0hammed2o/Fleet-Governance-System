  assignedDriverId String?
  assignedDriver   Driver? @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)

  // Quick-access expiry fields for authorisation checks/dashboards, deliberately
  // duplicated alongside the full ComplianceDocument record (which carries the
