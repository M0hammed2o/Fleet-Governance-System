enum ComplianceDocumentOwnerType {
  DRIVER
  VEHICLE
}

enum ComplianceDocumentType {
  DRIVER_LICENCE
  PDP
  VEHICLE_LICENCE
  ROADWORTHY_CERTIFICATE
  INSURANCE
  OTHER
}

enum DocumentVerificationStatus {
  UNVERIFIED
  VERIFIED
  REJECTED
}

// Reusable document/compliance record — one table for both driver and vehicle
// documents (build brief 7.3 Driver "Supporting documents", 7.4 Vehicle
// "Vehicle documents", and the dedicated "Document and compliance records"
// section). Exactly one of driverId/vehicleId is set, matching ownerType.
model ComplianceDocument {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ownerType ComplianceDocumentOwnerType
  driverId  String?
  driver    Driver?                     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle?                    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  documentType   ComplianceDocumentType
  documentNumber String?
  issueDate      DateTime?
  expiryDate     DateTime?
  issuer         String?
  notes          String?

  // Real secure upload (Phase 4) — was a dev-mode placeholder string before
  // this migration, see DECISIONS.md D-012.
  attachmentMediaAssetId String?     @unique
  attachmentMediaAsset   MediaAsset? @relation("ComplianceDocumentAttachment", fields: [attachmentMediaAssetId], references: [id], onDelete: SetNull)

  verificationStatus DocumentVerificationStatus @default(UNVERIFIED)
  verifiedById       String?
  verifiedAt         DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([tenantId])
  @@index([driverId])
  @@index([vehicleId])
