// Gate Fleet Governance — Phase 1 foundation schema.
// See DATA_MODEL.md for the narrative explanation of relationships and lifecycle.
// Every tenant-owned model carries a required tenantId — see ARCHITECTURE.md "tenant-isolation strategy".

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tenant / organisation structure
// ---------------------------------------------------------------------------

model Tenant {
  id                       String                   @id @default(cuid())
  name                     String
  slug                     String                   @unique
  timezone                 String                   @default("Africa/Johannesburg")
  currency                 String                   @default("ZAR")
  status                   TenantStatus             @default(ACTIVE)
  // Movement-approval policy (build brief 7.5/7.7: "must not approve their own
  // movement request where tenant policy prohibits self-approval"). Default is
  // the safer option — self-approval disabled — tenants opt in explicitly.
  allowSelfApproveMovement Boolean                  @default(false)
  // Phase 7 (SUPPORT-001) — a manually-set status flag for the platform
  // customer health summary, deliberately NOT a real billing/payment
  // integration (subscription billing is explicitly out of scope for this
  // build run, PRODUCT_REQUIREMENTS.md "Unresolved questions" #5). Set by a
  // Platform Administrator; no invoicing, no payment provider, no automatic
  // transitions.
  subscriptionStatus       TenantSubscriptionStatus @default(TRIAL)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  sites                                 Site[]
  gates                                 Gate[]
  users                                 User[]
  roles                                 Role[]
  sessions                              Session[]
  approvalDelegations                   ApprovalDelegation[]
  auditLogs                             AuditLog[]
  userPermissionOverrides               UserPermissionOverride[]
  userInvitations                       UserInvitation[]
  drivers                               Driver[]
  vehicles                              Vehicle[]
  complianceDocuments                   ComplianceDocument[]
  documentExpiryRules                   DocumentExpiryRule[]
  tyrePositionConfigs                   TyrePositionConfig[]
  vehicleTyres                          VehicleTyre[]
  movementAuthorisations                MovementAuthorisation[]
  manualFacialVerificationFallbacks     ManualFacialVerificationFallback[]
  inspectionTemplates                   InspectionTemplate[]
  gateEvents                            GateEvent[]
  gateEventInspectionItems              GateEventInspectionItem[]
  exceptionTypes                        ExceptionType[]
  exceptions                            Exception[]
  mediaAssets                           MediaAsset[]
  reconciliations                       Reconciliation[]
  reconciliationDiscrepancies           ReconciliationDiscrepancy[]
  telematicsEvents                      TelematicsEvent[]
  geofences                             Geofence[]
  manualGpsConfirmations                ManualGpsConfirmation[]
  vehicleUsePolicies                    VehicleUsePolicy[]
  supportAccessSessionsAsActorTenant    SupportAccessSession[]             @relation("SupportAccessSessionActorTenant")
  supportAccessSessionsAsCustomerTenant SupportAccessSession[]             @relation("SupportAccessSessionCustomerTenant")
  supportNotesAsAuthorTenant            SupportNote[]                      @relation("SupportNoteAuthorTenant")
  supportNotesAsCustomerTenant          SupportNote[]                      @relation("SupportNoteCustomerTenant")
  retentionPolicies                     RetentionPolicy[]
  deletionRequests                      DeletionRequest[]
  deletionCertificates                  DeletionCertificate[]
  exportRequests                        ExportRequest[]
  retentionNotificationRecords          RetentionNotificationRecord[]
  driverFacialTemplates                 DriverFacialTemplate[]
  facialVerificationAttempts            FacialVerificationAttempt[]
  cloudFallbackInvocations              CloudFallbackInvocation[]

  // --- Phase 10: subscriptions, billing and invoicing ---------------------
  billingProfile           TenantBillingProfile?
  customerBillingContacts  CustomerBillingContact[]
  pricingAgreements        TenantPricingAgreement[]
  subscription             TenantSubscription?
  billingPeriods           BillingPeriod[]
  billableVehicleSnapshots BillableVehicleSnapshot[]
  invoices                 Invoice[]
  payments                 Payment[]
  paymentAttempts          PaymentAttempt[]
  billingEmailDeliveries   BillingEmailDelivery[]
  creditAdjustments        CreditAdjustment[]

  // --- Phase 11: investigation, internal review and external audit case management ---
  investigationSettings            TenantInvestigationSettings?
  investigationCaseSequences       InvestigationCaseSequence[]
  investigationCases               InvestigationCase[]
  investigationSubjects            InvestigationSubject[]
  investigationRelatedRecords      InvestigationRelatedRecord[]
  investigationNotes               InvestigationNote[]
  investigationTasks               InvestigationTask[]
  investigationFindings            InvestigationFinding[]
  investigationApprovals           InvestigationApproval[]
  investigationEvidenceLinks       InvestigationEvidenceLink[]
  investigationChronologyEvents    InvestigationChronologyEvent[]
  externalAuditorAccessGrants      ExternalAuditorAccessGrant[]
  externalAuditorAccessLogs        ExternalAuditorAccessLog[]
  investigationNotificationRecords InvestigationNotificationRecord[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum TenantSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

model Site {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name             String
  address          String?
  timezoneOverride String?
  archivedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gates                  Gate[]
  movementAuthorisations MovementAuthorisation[]
  gateEvents             GateEvent[]

  @@index([tenantId])
  @@map("sites")
}

enum GateDirection {
  ENTRY
  EXIT
  BOTH
}

model Gate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  siteId   String
  site     Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  name       String
  direction  GateDirection @default(BOTH)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gateEvents                 GateEvent[]
  facialVerificationAttempts FacialVerificationAttempt[]

  @@index([tenantId])
  @@index([siteId])
  @@map("gates")
}

// ---------------------------------------------------------------------------
// Users, roles, permissions
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String
  // Null until the user accepts their invitation and sets a password — see
  // UserInvitation. A null passwordHash must never be treated as "any
  // password accepted"; login explicitly rejects it (lib/auth/password.ts).
  passwordHash String?
  name         String
  status       UserStatus @default(INVITED)

  mfaEnabled Boolean @default(false)
  mfaSecret  String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  sessions                            Session[]
  permissionOverrides                 UserPermissionOverride[]
  delegationsGiven                    ApprovalDelegation[]               @relation("DelegationDelegator")
  delegationsReceived                 ApprovalDelegation[]               @relation("DelegationDelegate")
  auditLogs                           AuditLog[]
  invitation                          UserInvitation?                    @relation("InvitationForUser")
  invitationsSent                     UserInvitation[]                   @relation("InvitationsSentBy")
  movementRequests                    MovementAuthorisation[]            @relation("MovementRequester")
  movementApprovals                   MovementAuthorisation[]            @relation("MovementApprover")
  manualFallbacksRequested            ManualFacialVerificationFallback[] @relation("ManualFallbackRequestedBy")
  manualFallbacksApproved             ManualFacialVerificationFallback[] @relation("ManualFallbackApprovedBy")
  gateEventsAsOfficer                 GateEvent[]                        @relation("GateEventOfficer")
  gateEventDecisions                  GateEvent[]                        @relation("GateEventDecisionBy")
  inspectionResultsRecorded           GateEventInspectionItem[]          @relation("InspectionResultRecordedBy")
  exceptionsRaised                    Exception[]                        @relation("ExceptionRaisedBy")
  exceptionsResolved                  Exception[]                        @relation("ExceptionResolvedBy")
  mediaAssetsCaptured                 MediaAsset[]                       @relation("MediaAssetCapturedBy")
  reconciliationsBuilt                Reconciliation[]                   @relation("ReconciliationBuiltBy")
  reconciliationDiscrepanciesResolved ReconciliationDiscrepancy[]        @relation("DiscrepancyResolvedBy")
  manualGpsConfirmationsRequested     ManualGpsConfirmation[]            @relation("ManualGpsConfirmationRequestedBy")
  manualGpsConfirmationsApproved      ManualGpsConfirmation[]            @relation("ManualGpsConfirmationApprovedBy")
  vehicleUsePoliciesApproving         VehicleUsePolicy[]                 @relation("VehicleUsePolicyApprovingManager")
  supportAccessSessionsAsActor        SupportAccessSession[]             @relation("SupportAccessSessionActor")
  supportNotesAuthored                SupportNote[]                      @relation("SupportNoteAuthor")
  deletionRequestsInitiated           DeletionRequest[]                  @relation("DeletionRequestInitiatedBy")
  deletionRequestsApproved            DeletionRequest[]                  @relation("DeletionRequestApprovedBy")
  deletionRequestsRejected            DeletionRequest[]                  @relation("DeletionRequestRejectedBy")
  exportRequestsRequested             ExportRequest[]                    @relation("ExportRequestRequestedBy")
  driverFacialTemplatesEnrolled       DriverFacialTemplate[]             @relation("DriverFacialTemplateEnrolledBy")
  driverFacialTemplatesRevoked        DriverFacialTemplate[]             @relation("DriverFacialTemplateRevokedBy")
  facialVerificationAttemptsAsOfficer FacialVerificationAttempt[]        @relation("FacialVerificationAttemptOfficer")

  // --- Phase 10: subscriptions, billing and invoicing ---------------------
  platformPricingVersionsCreated    PlatformPricingVersion[]  @relation("PlatformPricingVersionCreatedBy")
  platformBillingSettingsUpdated    PlatformBillingSettings[] @relation("PlatformBillingSettingsUpdatedBy")
  tenantPricingAgreementsCreated    TenantPricingAgreement[]  @relation("TenantPricingAgreementCreatedBy")
  tenantSubscriptionsSuspended      TenantSubscription[]      @relation("TenantSubscriptionSuspendedBy")
  tenantSubscriptionsRestored       TenantSubscription[]      @relation("TenantSubscriptionRestoredBy")
  billableVehicleSnapshotsGenerated BillableVehicleSnapshot[] @relation("BillableVehicleSnapshotGeneratedBy")
  invoicesCreated                   Invoice[]                 @relation("InvoiceCreatedBy")
  invoicesVoided                    Invoice[]                 @relation("InvoiceVoidedBy")
  paymentsRecorded                  Payment[]                 @relation("PaymentRecordedBy")
  billingEmailDeliveriesTriggered   BillingEmailDelivery[]    @relation("BillingEmailDeliveryTriggeredBy")
  creditAdjustmentsCreated          CreditAdjustment[]        @relation("CreditAdjustmentCreatedBy")

  // --- Phase 11: investigation, internal review and external audit case management ---
  investigationCasesAsReportingPerson   InvestigationCase[]               @relation("InvestigationCaseReportingPerson")
  investigationCasesAssigned            InvestigationCase[]               @relation("InvestigationCaseAssignedInvestigator")
  investigationCasesOwned               InvestigationCase[]               @relation("InvestigationCaseOwner")
  investigationCasesCreated             InvestigationCase[]               @relation("InvestigationCaseCreatedBy")
  investigationCasesClosed              InvestigationCase[]               @relation("InvestigationCaseClosedBy")
  investigationCasesReopened            InvestigationCase[]               @relation("InvestigationCaseReopenedBy")
  investigationCaseHoldsReleased        InvestigationCase[]               @relation("InvestigationCaseHoldReleasedBy")
  investigationSubjectLinks             InvestigationSubject[]            @relation("InvestigationSubjectUser")
  investigationSubjectsCreated          InvestigationSubject[]            @relation("InvestigationSubjectCreatedBy")
  investigationRelatedRecordsLinked     InvestigationRelatedRecord[]      @relation("InvestigationRelatedRecordLinkedBy")
  investigationNotesAuthored            InvestigationNote[]               @relation("InvestigationNoteAuthor")
  investigationTasksAssigned            InvestigationTask[]               @relation("InvestigationTaskAssignedTo")
  investigationTasksCompleted           InvestigationTask[]               @relation("InvestigationTaskCompletedBy")
  investigationTasksCreated             InvestigationTask[]               @relation("InvestigationTaskCreatedBy")
  investigationFindingsCreated          InvestigationFinding[]            @relation("InvestigationFindingCreatedBy")
  investigationFindingsSubmitted        InvestigationFinding[]            @relation("InvestigationFindingSubmittedBy")
  investigationApprovalActions          InvestigationApproval[]           @relation("InvestigationApprovalActor")
  investigationEvidenceLinksAdded       InvestigationEvidenceLink[]       @relation("InvestigationEvidenceLinkAddedBy")
  investigationEvidenceLinksMarkedError InvestigationEvidenceLink[]       @relation("InvestigationEvidenceLinkEnteredInErrorBy")
  investigationChronologyEventsActed    InvestigationChronologyEvent[]    @relation("InvestigationChronologyEventActor")
  externalAuditorAccessGrantsAsAuditor  ExternalAuditorAccessGrant[]      @relation("ExternalAuditorAccessGrantAuditor")
  externalAuditorAccessGrantsGranted    ExternalAuditorAccessGrant[]      @relation("ExternalAuditorAccessGrantGrantedBy")
  externalAuditorAccessGrantsRevoked    ExternalAuditorAccessGrant[]      @relation("ExternalAuditorAccessGrantRevokedBy")
  externalAuditorAccessLogsActed        ExternalAuditorAccessLog[]        @relation("ExternalAuditorAccessLogActor")
  investigationNotificationsReceived    InvestigationNotificationRecord[] @relation("InvestigationNotificationRecipient")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// One invitation per invited user. Created together with the User row
// (status INVITED, passwordHash null) when an admin invites someone; accepting
// sets passwordHash and status ACTIVE. See lib/auth/invitation.ts.
model UserInvitation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation("InvitationForUser", fields: [userId], references: [id], onDelete: Cascade)

  // SHA-256 hex digest of the opaque invitation token — same pattern as
  // Session.tokenHash, the raw token is never persisted.
  tokenHash String @unique

  invitedById String
  invitedBy   User   @relation("InvitationsSentBy", fields: [invitedById], references: [id])

  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("user_invitations")
}

model Role {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name        String
  description String?
  isSystem    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  REJECT
  EXPORT
  AUDIT
  CONFIGURE
}

// Global permission catalogue — not tenant-scoped. Seeded once; tenants compose
// roles from this fixed set rather than defining arbitrary new permissions.
model Permission {
  id          String           @id @default(cuid())
  resource    String
  action      PermissionAction
  description String?

  rolePermissions RolePermission[]
  overrides       UserPermissionOverride[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

enum OverrideEffect {
  GRANT
  REVOKE
}

model UserPermissionOverride {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  effect    OverrideEffect
  reason    String
  grantedBy String

  createdAt DateTime @default(now())

  @@unique([userId, permissionId])
  @@index([tenantId])
  @@map("user_permission_overrides")
}

// ---------------------------------------------------------------------------
// Sessions
// ---------------------------------------------------------------------------

model Session {
  id        String @id @default(cuid())
  // SHA-256 hex digest of the opaque bearer token stored in the client's cookie.
  // The raw token is never persisted, so a DB leak alone does not yield valid
  // sessions. See lib/auth/session.ts.
  tokenHash String @unique
  tenantId  String
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  expiresAt DateTime
  ip        String?
  userAgent String?
  revokedAt DateTime?

  @@index([tenantId])
  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Approval delegation
// ---------------------------------------------------------------------------

model ApprovalDelegation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  delegatorId String
  delegator   User   @relation("DelegationDelegator", fields: [delegatorId], references: [id], onDelete: Cascade)
  delegateId  String
  delegate    User   @relation("DelegationDelegate", fields: [delegateId], references: [id], onDelete: Cascade)

  // resource+action scope this delegation covers, e.g. "movement:approve"
  permissionScope String

  startAt   DateTime
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([delegateId])
  @@map("approval_delegations")
}

// ---------------------------------------------------------------------------
// Audit log — append-only. Application code must never expose update/delete
// on this model. See lib/audit/record-audit.ts (Phase 1 auth foundation).
// ---------------------------------------------------------------------------

model AuditLog {
  id       String  @id @default(cuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  timestamp     DateTime @default(now())
  ip            String?
  sessionId     String?
  action        String
  entityType    String
  entityId      String
  beforeValue   Json?
  afterValue    Json?
  reason        String?
  correlationId String?

  relatedGateEventId String?

  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([tenantId, timestamp])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Master data: drivers, vehicles, compliance documents, tyre
// configuration, movement authorisation. See PRODUCT_REQUIREMENTS.md MD-001..006.
// ---------------------------------------------------------------------------

enum DriverStatus {
  ACTIVE
  SUSPENDED
  BLACKLISTED
}

model Driver {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeNumber       String?
  name                 String
  contactPhone         String?
  contactEmail         String?
  // Real secure upload (Phase 4) — was a dev-mode pasted-URL placeholder
  // before this migration, see DECISIONS.md D-012. One MediaAsset can back at
  // most one driver's portrait (@unique), enforced the same way as the other
  // MediaAsset-backed single-owner fields below.
  portraitMediaAssetId String?     @unique
  portraitMediaAsset   MediaAsset? @relation("DriverPortrait", fields: [portraitMediaAssetId], references: [id], onDelete: SetNull)
  department           String?

  status DriverStatus @default(ACTIVE)

  licenceNumber String?
  licenceClass  String?
  licenceExpiry DateTime?
  pdpNumber     String?
  pdpExpiry     DateTime?

  authorisedVehicleClasses String[] @default([])
  restrictions             String?

  // Facial-verification enrolment status — see FacialVerificationProvider
  // interface, INTEGRATIONS.md. No production provider selected yet; this
  // only tracks whether a driver has been enrolled with whichever provider
  // (mock, in dev) is configured.
  facialVerificationEnrolled   Boolean   @default(false)
  facialVerificationProvider   String?
  facialVerificationEnrolledAt DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  assignedVehicles                  Vehicle[]
  complianceDocuments               ComplianceDocument[]
  movementAuthorisations            MovementAuthorisation[]
  manualFacialVerificationFallbacks ManualFacialVerificationFallback[]
  gateEvents                        GateEvent[]
  vehicleUsePolicies                VehicleUsePolicy[]
  facialTemplates                   DriverFacialTemplate[]
  facialVerificationAttempts        FacialVerificationAttempt[]
  investigationSubjectLinks         InvestigationSubject[]

  @@index([tenantId])
  @@map("drivers")
}

enum ManualFallbackStatus {
  PENDING
  APPROVED
  DENIED
}

// Records a manual facial-verification fallback decision — build brief 7.3:
// "Manual fallback must record: Reason, Security officer, Approving
// supervisor, Timestamp, Evidence where applicable, Audit event." Not tied to
// a GateEvent yet (Phase 3 doesn't exist here) — relatedGateEventId is a
// forward-compatible nullable field, same pattern as AuditLog's.
model ManualFacialVerificationFallback {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  reason String

  requestedByUserId String
  requestedBy       User    @relation("ManualFallbackRequestedBy", fields: [requestedByUserId], references: [id])
  approvedByUserId  String?
  approvedBy        User?   @relation("ManualFallbackApprovedBy", fields: [approvedByUserId], references: [id])

  status               ManualFallbackStatus @default(PENDING)
  // Real secure upload (Phase 4) — was a dev-mode placeholder string before
  // this migration, see DECISIONS.md D-012.
  evidenceMediaAssetId String?              @unique
  evidenceMediaAsset   MediaAsset?          @relation("ManualFallbackEvidence", fields: [evidenceMediaAssetId], references: [id], onDelete: SetNull)

  relatedGateEventId String?

  requestedAt DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([tenantId])
  @@index([driverId])
  @@map("manual_facial_verification_fallbacks")
}

// ---------------------------------------------------------------------------
// Phase 9 — on-device one-to-one facial verification and basic liveness.
// See PRODUCT_REQUIREMENTS.md FACE-001..009, ARCHITECTURE.md "Facial
// verification architecture", FACIAL_VERIFICATION_LICENSING.md (commercial
// licensing verification, Phase 9B). Extends, does not replace, the existing
// FacialVerificationProvider adapter / ManualFacialVerificationFallback
// workflow above.
// ---------------------------------------------------------------------------

enum DriverFacialTemplateStatus {
  ACTIVE
  REVOKED
}

// One encrypted biometric template per driver — at most one ACTIVE at a
// time, enforced by a partial unique index applied directly in this
// model's own migration SQL (Prisma's schema DSL has no `WHERE` clause for
// `@@unique`, same pattern as JobRun's one-running-per-jobName guarantee
// above). Never stores raw enrolment images/video — only the resulting
// numeric face descriptor, encrypted; the encryption key itself lives
// outside this database entirely (SECURITY_AND_POPIA.md).
model DriverFacialTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  // AES-256-GCM ciphertext of the face descriptor (a small float array, not
  // an image) — see lib/facial-verification/template-encryption.ts.
  templateCiphertext Bytes
  templateIv         Bytes
  templateAuthTag    Bytes
  // Which key encrypted this row — supports future key rotation without
  // needing to re-encrypt every row atomically in one pass.
  encryptionKeyId    String

  // FACIAL_VERIFICATION_LICENSING.md's exact package/model identifiers,
  // recorded per template so a future model/package upgrade can identify
  // which templates were computed with which model generation.
  templateVersion String
  modelVersion    String

  status DriverFacialTemplateStatus @default(ACTIVE)

  // Biometric-processing notice + purpose/retention acknowledgement — a
  // timestamp, not a boolean, so it's evidence the notice was actually
  // shown at a specific moment, not just a UI checkbox default.
  consentAcknowledgedAt DateTime

  enrolledByUserId String
  enrolledBy       User     @relation("DriverFacialTemplateEnrolledBy", fields: [enrolledByUserId], references: [id])
  enrolledAt       DateTime @default(now())

  revokedByUserId String?
  revokedBy       User?     @relation("DriverFacialTemplateRevokedBy", fields: [revokedByUserId], references: [id])
  revokedAt       DateTime?
  revokedReason   String?

  createdAt DateTime @default(now())

  verificationAttempts FacialVerificationAttempt[]

  @@index([tenantId])
  @@index([driverId])
  @@map("driver_facial_templates")
}

enum FacialVerificationResultType {
  MATCH
  NO_MATCH
  REVIEW_REQUIRED
  NOT_ENROLLED
  CAPTURE_FAILED
  LIVENESS_FAILED
  PROVIDER_UNAVAILABLE
}

enum LivenessChallengeResult {
  PASSED
  FAILED
  NOT_REQUIRED
  SKIPPED
}

enum FacialVerificationSource {
  ON_DEVICE
  CLOUD_FALLBACK
  MANUAL_FALLBACK
}

// Full audit history of every one-to-one verification attempt at the gate
// — always against exactly one driver's template (the one assigned to the
// GateEvent's MovementAuthorisation), never a global identification
// search. One row per attempt, including retries.
model FacialVerificationAttempt {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  gateEventId String
  gateEvent   GateEvent @relation(fields: [gateEventId], references: [id], onDelete: Cascade)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  templateId String?
  template   DriverFacialTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  result FacialVerificationResultType

  confidenceScore Float?
  threshold       Float?
  templateVersion String?
  modelVersion    String?

  captureQualityScore Float?
  livenessResult      LivenessChallengeResult @default(NOT_REQUIRED)
  livenessChallenge   String?

  source FacialVerificationSource @default(ON_DEVICE)

  gateId                String
  gate                  Gate    @relation(fields: [gateId], references: [id])
  deviceLabel           String?
  securityOfficerUserId String
  securityOfficer       User    @relation("FacialVerificationAttemptOfficer", fields: [securityOfficerUserId], references: [id])

  manualFallbackUsed Boolean @default(false)
  manualFallbackId   String?

  attemptedAt DateTime @default(now())

  @@index([tenantId])
  @@index([gateEventId])
  @@index([driverId])
  @@map("facial_verification_attempts")
}

// Tracks CloudLivenessProvider invocations per tenant (Phase 9F) — "for
// future billing." No paid cloud vendor account exists (FACIAL_VERIFICATION_
// LICENSING.md) — this table exists so a future real integration has usage
// history to bill against from day one, not a retrofit.
model CloudFallbackInvocation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  facialVerificationAttemptId String?

  reason    String
  invokedAt DateTime @default(now())

  @@index([tenantId])
  @@map("cloud_fallback_invocations")
}

enum VehicleCategory {
  PASSENGER
  LIGHT_COMMERCIAL
  TRUCK
  TRUCK_DUAL_REAR_WHEEL
  TRAILER
  CUSTOM
}

enum VehicleOwnership {
  OWNED
  LEASED
  CONTRACTOR
  THIRD_PARTY
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  OTHER
}

enum GpsStatus {
  ACTIVE
  INACTIVE
  UNKNOWN
}

enum VehicleOperationalStatus {
  OPERATIONAL
  WORKSHOP_LOCKOUT
  SECURITY_LOCKOUT
  DECOMMISSIONED
}

model Vehicle {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fleetNumber        String?
  registrationNumber String
  vin                String?
  engineNumber       String?

  make   String?
  model  String?
