  tyrePositionConfigId String?
  tyrePositionConfig   TyrePositionConfig? @relation(fields: [tyrePositionConfigId], references: [id], onDelete: SetNull)

  // A trailer's default towing vehicle, or a truck's default attached trailer —
  // one level of self-relation, not a general graph. Per-movement trailer
