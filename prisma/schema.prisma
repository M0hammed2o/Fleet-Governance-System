  @@index([tenantId])
  @@map("vehicle_tyres")
}

enum MovementType {
  ENTRY
  EXIT
  DELIVERY
  COLLECTION
  RETURN
  SITE_TRANSFER
  MAINTENANCE
  OTHER
  // Phase 5C additions (DISPATCH-001) — "transfer" is already covered by the
  // existing SITE_TRANSFER, so only the three genuinely new categories were
  // added.
  SALES_VISIT
  SERVICE
  AUTHORISED_PRIVATE_USE
}

enum MovementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
  IN_PROGRESS
  COMPLETED
}

// Created and approved before the vehicle reaches the gate — build brief 7.5.
// Gate security (Phase 3) reads this record; it must never be edited from the
// gate-facing lookup, only referenced (see gate-facing lookup API — read-only).
model MovementAuthorisation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])

  vehicleId String
  vehicle   Vehicle @relation("MovementVehicle", fields: [vehicleId], references: [id])
  driverId  String
  driver    Driver  @relation(fields: [driverId], references: [id])

  trailerVehicleId String?
  trailerVehicle   Vehicle? @relation("MovementTrailer", fields: [trailerVehicleId], references: [id])

  movementType MovementType
  purpose      String?
  destination  String?

  expectedDepartureAt DateTime?
  expectedReturnAt    DateTime?
  // Planned/estimated round-trip distance, set at dispatch time — optional
  // baseline the Phase 5B reconciliation engine compares actual departure/
  // return odometer delta against to flag "excess mileage" (RECON-001). Null
  // means that check is simply skipped for this movement, not treated as 0.
  expectedDistanceKm  Float?

  customerProjectJobReference   String?
  deliveryOrCollectionReference String?
  purchaseOrderReference        String?
  approvedCargoSummary          String?
  sealOrContainerReference      String?

  // Phase 5C (DISPATCH-002) — who's sending/receiving, for movement types
  // where that's meaningful (delivery, collection, sales visit, service).
  // Free text, not FKs to Driver/User — a sender/recipient is very often an
  // external party (customer contact, site foreman) with no account in this
  // system at all.
  senderName       String?
  senderContact    String?
  recipientName    String?
  recipientContact String?

  // Phase 5C (DISPATCH-004) added this as a plain nullable String (no FK —
  // VehicleUsePolicy didn't exist yet). Phase 6 upgrades it to a real
  // relation now that the model exists — see DECISIONS.md D-019's revisit
  // condition.
  vehicleUsePolicyId String?
  vehicleUsePolicy   VehicleUsePolicy? @relation(fields: [vehicleUsePolicyId], references: [id])

  // Short human-friendly code for gate-facing lookup (QR/reference-code search).
  referenceCode String @unique

  requesterUserId String
  requester       User    @relation("MovementRequester", fields: [requesterUserId], references: [id])
  approverUserId  String?
  approver        User?   @relation("MovementApprover", fields: [approverUserId], references: [id])

  status           MovementStatus @default(DRAFT)
  approvalComments String?
  cancelledAt      DateTime?
  cancelledReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gateEvents     GateEvent[]
  reconciliation Reconciliation?

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([vehicleId])
  @@index([driverId])
  @@map("movement_authorisations")
}

// ---------------------------------------------------------------------------
// Phase 3 — Gate operations: GateEvent state machine, configurable guided
// inspection engine, tenant-configurable exceptions/approvals, security
// dashboard. See PRODUCT_REQUIREMENTS.md GATE-001..006 and ARCHITECTURE.md
// "Gate operations architecture".
// ---------------------------------------------------------------------------

enum GateEventDirection {
  ENTRY
  EXIT
}

// Presence/processing state of a vehicle actually at the gate — distinct from
// MovementAuthorisation.status (its own pre-gate approval state machine,
// already complete by the time a GateEvent exists). Pure transition table
// lives in lib/gate-events/state-machine.ts, mirroring
// lib/movements/state-machine.ts exactly.
enum GateEventStatus {
  EXPECTED
  INSPECTION_STARTED
  IDENTITY_PENDING
  IDENTITY_VERIFIED
  VEHICLE_CHECKS_IN_PROGRESS
  EXCEPTION_RAISED
  SUPERVISOR_REVIEW
  CLEARED
  DENIED
  CANCELLED
  COMPLETED
}

enum GateEventDecision {
  CLEARED
  DENIED
}

// A named, versioned, vehicle-category-aware checklist (build brief 7.6:
// "configurable inspection templates ... not hardcoded to one component").
// Editing an existing template creates a new row with an incremented version
// rather than mutating in place, so a GateEvent recorded against version 2
// keeps pointing at the exact questions that were actually asked, even after
// version 3 is published — same "don't rewrite history" principle as
// AuditLog's append-only guarantee.
model InspectionTemplate {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name            String
  description     String?
  // Null = applies to every vehicle category (a generic fallback template).
  vehicleCategory VehicleCategory?
  version         Int              @default(1)
  isActive        Boolean          @default(true)
  isSystem        Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items      InspectionItem[]
  gateEvents GateEvent[]

  @@unique([tenantId, name, version])
  @@index([tenantId])
  @@index([tenantId, vehicleCategory, isActive])
  @@map("inspection_templates")
}

enum InspectionSection {
  DRIVER_AUTHORISATION
  VEHICLE_IDENTITY
  EXTERIOR_CONDITION
  LIGHTS
  TYRES_WHEELS
  OPERATIONAL_INFO
  LOAD_VERIFICATION
}

enum InspectionResponseType {
  CHECK
  READING
  TEXT
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// One ordered question within a template — grouped by section, matching the
// categories already implied by the Vehicle/Driver/Tyre models (build brief
// 7.6). responseType CHECK yields a GateEventInspectionItem.outcome of
// pass/fail/not-applicable/unable-to-verify; READING additionally expects a
// readingValue + readingUnit (e.g. tyre tread depth in mm); TEXT is freeform.
model InspectionItem {
  id         String             @id @default(cuid())
  templateId String
  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  section     InspectionSection
  label       String
  description String?
  sortOrder   Int               @default(0)

  responseType InspectionResponseType @default(CHECK)
  unit         String?

  isRequired Boolean @default(true)

  // What a FAIL outcome on this item should default to — feeds
  // gate-event-repository.ts's automatic exception raising. Null means a FAIL
  // here doesn't automatically raise a formal exception (still recorded).
  defaultExceptionSeverity         ExceptionSeverity?
  requiresSupervisorApprovalOnFail Boolean            @default(false)

  results                     GateEventInspectionItem[]
  reconciliationDiscrepancies ReconciliationDiscrepancy[]

  @@index([templateId])
  @@map("inspection_items")
}

// The actual gate-side record of a vehicle's presence and processing at a
// gate for one entry or exit, linked back to the MovementAuthorisation it
// corresponds to (build brief 7.6/7.7). One MovementAuthorisation should only
// ever have one *open* (non-terminal) GateEvent at a time — enforced in
// gate-event-repository.ts's startGateEvent (idempotent: a duplicate "start"
// call returns the existing open GateEvent rather than creating a second one)
// since there's no clean partial-unique-index for "one non-terminal row per
// movementAuthorisationId" in Postgres without a generated column.
model GateEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id])
  gateId String
  gate   Gate   @relation(fields: [gateId], references: [id])

  direction GateEventDirection

  vehicleId        String
  vehicle          Vehicle  @relation("GateEventVehicle", fields: [vehicleId], references: [id])
  trailerVehicleId String?
  trailerVehicle   Vehicle? @relation("GateEventTrailer", fields: [trailerVehicleId], references: [id])
  driverId         String
  driver           Driver   @relation(fields: [driverId], references: [id])

  movementAuthorisationId String
  movementAuthorisation   MovementAuthorisation @relation(fields: [movementAuthorisationId], references: [id])

  securityOfficerUserId String
  securityOfficer       User   @relation("GateEventOfficer", fields: [securityOfficerUserId], references: [id])

  inspectionTemplateId String?
  inspectionTemplate   InspectionTemplate? @relation(fields: [inspectionTemplateId], references: [id])

  status GateEventStatus @default(EXPECTED)

  // Driver verification result for this gate event — wires the existing
  // FacialVerificationProvider (mock) / ManualFacialVerificationFallback into
  // the gate check-in flow (build brief 7.6, GATE item 5). Not a new
  // verification mechanism; this only records the outcome against this event.
  identityVerificationResult String?
  identityVerificationRef    String?
  identityVerifiedAt         DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  decision         GateEventDecision?
  decisionReason   String?
  decisionByUserId String?
  decisionBy       User?              @relation("GateEventDecisionBy", fields: [decisionByUserId], references: [id])
  decisionAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspectionResults          GateEventInspectionItem[]
  exceptions                 Exception[]
  reconciliationAsDeparture  Reconciliation?             @relation("ReconciliationDeparture")
  reconciliationAsReturn     Reconciliation?             @relation("ReconciliationReturn")
  facialVerificationAttempts FacialVerificationAttempt[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([movementAuthorisationId])
  @@index([vehicleId])
  @@index([tenantId, createdAt])
  @@map("gate_events")
}

enum InspectionOutcome {
  PASS
  FAIL
  NOT_APPLICABLE
  UNABLE_TO_VERIFY
}

// One answer against one InspectionItem for one GateEvent (build brief 7.6:
// "record actual answers against a template for one GateEvent"). Evidence
// capture is a dev-mode placeholder URL string only — real upload is Phase 4
// (ARCHITECTURE.md "Media/video architecture"), same pattern as
// Driver.portraitUrl / ComplianceDocument.attachmentUrl.
model GateEventInspectionItem {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  gateEventId String
  gateEvent   GateEvent @relation(fields: [gateEventId], references: [id], onDelete: Cascade)

  inspectionItemId String
  inspectionItem   InspectionItem @relation(fields: [inspectionItemId], references: [id])

  outcome      InspectionOutcome
  readingValue String?
  readingUnit  String?
  comment      String?

  exceptionSeverity          ExceptionSeverity?
  supervisorApprovalRequired Boolean            @default(false)

  // Real secure upload (Phase 4) — was a dev-mode placeholder string before
  // this migration, see DECISIONS.md D-012.
  evidenceMediaAssetId String?     @unique
  evidenceMediaAsset   MediaAsset? @relation("InspectionItemEvidence", fields: [evidenceMediaAssetId], references: [id], onDelete: SetNull)

  recordedByUserId String
  recordedBy       User     @relation("InspectionResultRecordedBy", fields: [recordedByUserId], references: [id])
  recordedAt       DateTime @default(now())

  exceptions Exception[]

  @@unique([gateEventId, inspectionItemId])
  @@index([tenantId])
  @@index([gateEventId])
  @@map("gate_event_inspection_items")
}

enum ExceptionOutcomeAction {
  WARNING
  MANUAL_REVIEW
  SUPERVISOR_APPROVAL
  WORKSHOP_LOCKOUT
  SECURITY_HOLD
  DENIED
  CLEARED_WITH_OBSERVATION
}

// Tenant-configurable exception category — same pattern as
// DocumentExpiryRule: a tenant defines what kind of exceptions it recognises
// and what should typically happen (build brief GATE item 3: "configurable
// per tenant"). requiresSupervisorApproval drives the hard self-approval rule
// in gate-event-repository.ts (see DECISIONS.md) — deliberately NOT a
// tenant-toggleable flag like Tenant.allowSelfApproveMovement; identity/safety
// exception integrity is not made optional.
model ExceptionType {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code        String
  label       String
  description String?

  defaultSeverity            ExceptionSeverity      @default(MEDIUM)
  defaultOutcomeAction       ExceptionOutcomeAction @default(MANUAL_REVIEW)
  requiresSupervisorApproval Boolean                @default(false)
  isSystem                   Boolean                @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exceptions Exception[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("exception_types")
}

// An actual exception instance raised against a GateEvent — optionally tied
// to the specific inspection answer that triggered it (auto-raised on a FAIL
// outcome by gate-event-repository.ts) or raised ad hoc by the officer.
model Exception {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Nullable from Phase 6 (GPS-005/POLICY-002): a telematics/geofence/policy
  // exception is raised against a vehicle mid-trip, with no GateEvent in
  // context at all — see DECISIONS.md D-020. Every Phase 3/5B exception still
  // always sets this (gate-event-repository.ts, reconciliation-repository.ts
  // never pass null); only the new telematics-repository.ts path leaves it
  // null and sets `vehicleId` instead.
  gateEventId String?
  gateEvent   GateEvent? @relation(fields: [gateEventId], references: [id], onDelete: Cascade)

  // Phase 6 — set (instead of gateEventId) for telematics/policy exceptions.
  vehicleId String?
  vehicle   Vehicle? @relation("ExceptionVehicle", fields: [vehicleId], references: [id], onDelete: Cascade)

  inspectionResultId String?
  inspectionResult   GateEventInspectionItem? @relation(fields: [inspectionResultId], references: [id], onDelete: SetNull)

  exceptionTypeId String?
  exceptionType   ExceptionType? @relation(fields: [exceptionTypeId], references: [id])

  description String
  severity    ExceptionSeverity @default(MEDIUM)

  // Hard rule (not tenant-configurable — see DECISIONS.md): if true, the
  // officer who raised this exception cannot be the one who resolves it,
  // enforced in gate-event-repository.ts regardless of role/permission.
  requiresSupervisorApproval Boolean                 @default(false)
  outcomeAction              ExceptionOutcomeAction?

  raisedByUserId String
  raisedBy       User     @relation("ExceptionRaisedBy", fields: [raisedByUserId], references: [id])
  raisedAt       DateTime @default(now())

  resolvedByUserId String?
  resolvedBy       User?     @relation("ExceptionResolvedBy", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  resolutionNotes  String?

  // Phase 8A (GPS-exception deduplication) — set only for telematics/policy
  // exceptions (vehicleId-scoped, gateEventId null). Identifies which
  // PolicyViolationType (lib/telematics/geofence-engine.ts) this episode is
  // tracking, so a repeat sync that finds the same still-ongoing violation
  // updates the existing open row instead of creating a duplicate. Null for
  // every Phase 3/5B gate-event/reconciliation exception.
  violationType    String?
  // How many consecutive syncs have re-observed this violation still open —
  // used to escalate a continuing violation to HIGH/supervisor-approval
  // after it persists rather than leaving it at its original severity
  // forever. Meaningless (stays 1) for non-telematics exceptions.
  observationCount Int       @default(1)
  // When this still-open telematics violation was last confirmed ongoing —
  // distinct from raisedAt (episode start). Null for non-telematics
  // exceptions.
  lastObservedAt   DateTime?

  reconciliationDiscrepancy ReconciliationDiscrepancy?

  @@index([tenantId])
  @@index([gateEventId])
  @@index([tenantId, resolvedAt])
  @@index([vehicleId, violationType, resolvedAt])
  @@map("exceptions")
}

// ---------------------------------------------------------------------------
// Phase 4 — Evidence and media. See PRODUCT_REQUIREMENTS.md EVID-001..004 and
// ARCHITECTURE.md "Media/video architecture".
// ---------------------------------------------------------------------------

enum MediaAssetOwnerType {
  GATE_EVENT
  GATE_EVENT_INSPECTION_ITEM
  MANUAL_FACIAL_VERIFICATION_FALLBACK
  DRIVER_PORTRAIT
  COMPLIANCE_DOCUMENT
  // Phase 5C (DISPATCH-003) — delivery notes / supporting movement documents.
  // Many-to-one with MovementAuthorisation (a movement can have several
  // documents), unlike DRIVER_PORTRAIT's implicit 1:1 — no unique constraint
  // needed, same (ownerType, ownerId) polymorphic pattern as GATE_EVENT.
  MOVEMENT_DOCUMENT
  // Phase 10 (P10E) — a generated invoice PDF. 1:1 with its Invoice
  // (Invoice.pdfMediaAssetId), reusing the existing signed-URL/object-storage
  // architecture rather than a new "documents" store — see D-035.
  INVOICE
  // Phase 11 (P11F) — an evidence item uploaded directly to an investigation
  // case (as opposed to a piece of evidence linked in from an already-owned
  // record, e.g. GATE_EVENT_INSPECTION_ITEM, which keeps its original
  // ownerType and is simply referenced by InvestigationEvidenceLink).
  INVESTIGATION_CASE
  // Phase 11 (P11J) — a generated investigation-case report PDF. Many per
  // case (one per approved version), same one-directional
  // (ownerType, ownerId) pattern as INVOICE, not a unique 1:1.
  INVESTIGATION_REPORT
}

enum MediaDataClassification {
  RESTRICTED
  CONFIDENTIAL
  INTERNAL
}

// Phase 8B (cost-efficient media architecture) — storage/retention/billing
// classification, orthogonal to `MediaAssetOwnerType` (which describes which
// *record* owns this evidence, not what *kind* of evidence it is). See
// ARCHITECTURE.md "Object-storage architecture" and DECISIONS.md.
enum MediaCategory {
  DRIVER_PORTRAIT
  FACIAL_AUDIT
  VEHICLE_INSPECTION_PHOTO
  VEHICLE_INSPECTION_VIDEO
  DAMAGE_EVIDENCE
  CARGO_EVIDENCE
  DELIVERY_DOCUMENT
  INVESTIGATION_EVIDENCE
  GENERATED_REPORT
  OTHER_DOCUMENT
}

// Phase 8B upload-status lifecycle. PENDING = a presigned upload URL was
// minted but the object hasn't been confirmed yet; PROCESSING = confirmed,
// compression/thumbnail generation running; READY = usable; FAILED = the
// upload never completed or processing failed — eligible for cleanup.
enum MediaUploadStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// One reusable, polymorphic model for every kind of uploaded evidence in the
// system — gate-event walk-around photos/video, a single inspection item's
// evidence, manual facial-verification fallback evidence, driver portraits,
// and compliance document attachments — following the same "one reusable
// model with an ownerType discriminator" principle as ComplianceDocument
// (Phase 2), but using a plain (ownerType, ownerId) pair rather than N
// nullable FK columns since there are 5 owner kinds here, not 2 — the same
// shape AuditLog already uses for (entityType, entityId). See DECISIONS.md
// D-011.
//
// No public/permanent URL is ever exposed: all reads go through
// mintSignedUrlForMediaAsset() (lib/repositories/media-asset-repository.ts),
// which mints a short-lived signed URL after a permission check, verified
// server-side by lib/storage/signed-url.ts. Files live under the gitignored
// `.data/media/` directory in dev (lib/storage/local-filesystem-provider.ts)
// and are never served through Next's static file handling.
model MediaAsset {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ownerType MediaAssetOwnerType
  ownerId   String

  // Nullable since Phase 10: a system/job-generated artifact (e.g. a
  // recurring-billing-job invoice PDF) has no human capturing officer —
  // distinct from every human-driven upload, which always sets this.
  capturedByUserId String?
  capturedBy       User?    @relation("MediaAssetCapturedBy", fields: [capturedByUserId], references: [id])
  capturedAt       DateTime @default(now())

  fileName       String
  contentType    String
  fileSizeBytes  Int
  // Opaque, tenant-namespaced storage location used only server-side by the
  // StorageProvider — never returned directly to a client, never a public path.
  storageKey     String @unique
  // SHA-256 hex digest computed server-side on receipt — never trusts a
  // client-supplied checksum. A client-supplied checksum, if present, is only
  // used as an optional integrity cross-check (see ChecksumMismatchError).
  checksumSha256 String

  classification MediaDataClassification @default(RESTRICTED)

  // Client-generated idempotency key so retrying an upload over flaky gate
  // connectivity never creates a duplicate evidence record — see
  // uploadMediaAsset() / IdempotencyKeyConflictError in
  // lib/repositories/media-asset-repository.ts.
  idempotencyKey String

  // --- Phase 8B: cost-efficient object-storage architecture ---------------
  category            MediaCategory     @default(OTHER_DOCUMENT)
  uploadStatus        MediaUploadStatus @default(READY)
  // Which ObjectStorageProvider implementation persisted this object
  // ("local" | "r2") — for accounting/dashboards, not used to route reads
  // (a MediaAsset's provider never changes after creation in this phase).
  storageProvider     String            @default("local")
  // Set only when a compressed/converted version differs from what the
  // client originally sent and policy requires keeping the original too
  // (flagged incidents — see ARCHITECTURE.md). Null otherwise: most evidence
  // only ever has one stored copy.
  originalStorageKey  String?
  thumbnailStorageKey String?
  // Named compression profile actually applied at upload time (see
  // lib/storage/media-categories.ts) — null if stored unmodified (e.g. a
  // content type this phase doesn't compress, like PDF documents).
  compressionProfile  String?
  // Capture-context metadata recorded alongside the file (device, original
  // resolution/duration, GPS if supplied, client capture timestamp) —
  // opaque JSON, never used for access control, purely descriptive.
  captureMetadata     Json?

  // --- Phase 8C: retention, archive and deletion ---------------------------
  // Both hard, unconditional blockers on deletion regardless of role/permission
  // — see DECISIONS.md and lib/retention/deletion-rules.ts.
  legalHold           Boolean              @default(false)
  investigationHold   Boolean              @default(false)
  retentionStatus     RetentionAssetStatus @default(ACTIVE)
  // Derived from the applicable RetentionPolicy at capture time
  // (capturedAt + retentionDays); recalculated when the policy or a hold
  // changes. Null means "not yet computed" (no policy existed at capture
  // time) — never treated as "never expires".
  scheduledDeletionAt DateTime?
  // Set only when a Company Administrator explicitly extends this asset's
  // scheduledDeletionAt (extendRetention() in retention-repository.ts) — a
  // hard marker so automatic assignment/backfill (8E-001) never overwrites
  // a deliberate human decision, distinct from "not yet computed" (null
  // scheduledDeletionAt with this also null) or an ordinary policy-derived
  // value (non-null scheduledDeletionAt with this still null).
  retentionExtendedAt DateTime?
  // Set only once the underlying binary is permanently deleted — the row
  // itself (this structured metadata) is preserved as the historical
  // record even after the bytes are gone (ARCHITECTURE.md "Preserve
  // structured operational records separately from large media files").
  // Once set, storageKey/thumbnailStorageKey/originalStorageKey no longer
  // point at anything readable.
  binaryDeletedAt     DateTime?

  createdAt DateTime @default(now())

  inspectionItemEvidenceFor       GateEventInspectionItem?          @relation("InspectionItemEvidence")
  manualFallbackEvidenceFor       ManualFacialVerificationFallback? @relation("ManualFallbackEvidence")
  driverPortraitFor               Driver?                           @relation("DriverPortrait")
  complianceDocumentAttachmentFor ComplianceDocument?               @relation("ComplianceDocumentAttachment")
  deletionRequestLinks            DeletionRequestAsset[]
  retentionNotifications          RetentionNotificationRecord[]
  invoiceAsPdf                    Invoice?                          @relation("InvoicePdf")
  investigationEvidenceLinks      InvestigationEvidenceLink[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, ownerType, ownerId])
  @@index([tenantId, retentionStatus, scheduledDeletionAt])
  @@map("media_assets")
}

// ---------------------------------------------------------------------------
// Phase 5B — Reconciliation. See PRODUCT_REQUIREMENTS.md RECON-001..003 and
// ARCHITECTURE.md "Reconciliation architecture". Pairs the departure and
// return GateEvent for one round-trip MovementAuthorisation and compares
// their recorded readings; never a parallel exception mechanism — significant
// discrepancies raise an ordinary Phase 3 Exception against the return
// GateEvent (lib/repositories/reconciliation-repository.ts).
// ---------------------------------------------------------------------------

enum ReconciliationStatus {
  // Built, compared, and found nothing worth a human's attention.
  NO_DISCREPANCIES
  // At least one discrepancy is still OPEN.
  OPEN
  // Had discrepancies; every one has since been reviewed and RESOLVED.
  RESOLVED
}

enum DiscrepancyCategory {
  ODOMETER
  FUEL
  VEHICLE_CONDITION
  TYRE_CONDITION
  CARGO_AND_LOAD
}

enum DiscrepancyStatus {
  OPEN
  RESOLVED
}

// One reconciliation per round-trip MovementAuthorisation — created once both
// its departure and return GateEvent are COMPLETED/CLEARED
// (buildReconciliation(), auto-triggered from completeGateEvent() and also
// callable directly/idempotently for a manual retry). "Departure" and
// "return" are assigned by chronological order (earlier completedAt =
// departure), not by a hardcoded ENTRY/EXIT assumption, so this works
// equally for a fleet vehicle leaving-then-returning (EXIT then ENTRY) and a
// visiting vehicle entering-then-leaving (ENTRY then EXIT) — see
// DECISIONS.md.
model Reconciliation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  movementAuthorisationId String                @unique
  movementAuthorisation   MovementAuthorisation @relation(fields: [movementAuthorisationId], references: [id])

  // @unique on both — a GateEvent can be the departure or return leg of at
  // most one Reconciliation, ever (RECON-001 "prevents ... duplicate
  // pairing"), enforced at the DB level, not just in application code.
  departureGateEventId String    @unique
  departureGateEvent   GateEvent @relation("ReconciliationDeparture", fields: [departureGateEventId], references: [id])
  returnGateEventId    String    @unique
  returnGateEvent      GateEvent @relation("ReconciliationReturn", fields: [returnGateEventId], references: [id])

  departureOdometer Int?
  returnOdometer    Int?
  kmTravelled       Int?

  departureFuelPercent Float?
  returnFuelPercent    Float?
  fuelDeltaPercent     Float?

  status ReconciliationStatus @default(NO_DISCREPANCIES)

  // Null when built automatically by the system (the common path, from
  // completeGateEvent) rather than via an explicit manual retry.
  builtByUserId String?
  builtBy       User?   @relation("ReconciliationBuiltBy", fields: [builtByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  discrepancies ReconciliationDiscrepancy[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("reconciliations")
}

// A single structured, reviewable comparison finding (RECON-002) — never an
// automatic accusation, only a factual departure-vs-return comparison plus a
// severity, awaiting human review/explanation/resolution. `severity` reuses
// the existing ExceptionSeverity scale for consistency with the rest of the
// gate-operations domain; the auto-engine never assigns CRITICAL itself
// (reserved for a human reviewer to escalate to).
model ReconciliationDiscrepancy {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  category    DiscrepancyCategory
  severity    ExceptionSeverity
  description String

  departureValue String?
  returnValue    String?
  deltaValue     Float?

  // Set when this discrepancy came from comparing a specific configured
  // inspection item (TYRES_WHEELS/EXTERIOR_CONDITION/LOAD_VERIFICATION) —
  // null for the odometer/fuel comparisons, which read directly off the
  // OPERATIONAL_INFO reading items but are surfaced as their own
  // ODOMETER/FUEL categories rather than a generic inspection-item diff.
  inspectionItemId String?
  inspectionItem   InspectionItem? @relation(fields: [inspectionItemId], references: [id])

  // Significant (HIGH) discrepancies raise a real Phase 3 Exception against
  // the return GateEvent — RECON-002 "via the existing Phase 3 exception
  // workflow rather than a parallel mechanism" — recorded here only as a
  // pointer for the detail page, never a second source of truth.
  linkedExceptionId String?    @unique
  linkedException   Exception? @relation(fields: [linkedExceptionId], references: [id], onDelete: SetNull)

  status DiscrepancyStatus @default(OPEN)

  resolvedByUserId String?
  resolvedBy       User?     @relation("DiscrepancyResolvedBy", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  resolutionNotes  String?
  correctiveAction String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([reconciliationId])
  @@index([tenantId, status])
  @@map("reconciliation_discrepancies")
}

// ---------------------------------------------------------------------------
// Phase 6 — Telematics foundation, basic geofencing, vehicle-use policies.
// See PRODUCT_REQUIREMENTS.md GPS-001..006/GPS-BLOCKED, POLICY-001/002 and
// ARCHITECTURE.md "Telematics architecture". Provider-neutral, following the
// exact FacialVerificationProvider/StorageProvider adapter pattern — only a
// deterministic mock provider exists; production connection is blocked
// (GPS-BLOCKED, INTEGRATIONS.md).
// ---------------------------------------------------------------------------

enum TelematicsEventSource {
  // From TelematicsProvider.getSnapshot() (mock in dev).
  PROVIDER
  // From the ManualGpsConfirmation workflow (GPS-002) — office staff
  // confirming a vehicle's whereabouts by phone/radio when GPS is offline.
  MANUAL
}

// One normalised position/status sample, regardless of source — the
// TelematicsProvider interface already normalises whatever a real vendor
// would return into this shape (lib/telematics/provider.ts), so this table
// never needs a vendor-specific column.
model TelematicsEvent {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  source TelematicsEventSource

  latitude       Float?
  longitude      Float?
  speedKmh       Float?
  headingDegrees Float?
  ignitionOn     Boolean?
  odometerKm     Float?

  // When the provider says this reading was actually taken — distinct from
  // createdAt (when we ingested it). GPS-006 "stale data is flagged, not
  // silently trusted" compares against this, not createdAt.
  recordedAt DateTime
  createdAt  DateTime @default(now())

  providerReference String?

  @@index([tenantId])
  @@index([tenantId, vehicleId, recordedAt])
  @@map("telematics_events")
}

// A simple circular geofence — deliberately not a polygon/map-drawing tool
// (out of scope for "basic geofence monitoring", GPS-004). center +
// radius is enough to express "must stay within N meters of the approved
// site/destination."
model Geofence {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name            String
  centerLatitude  Float
  centerLongitude Float
  radiusMeters    Float
  isSystem        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleUsePolicies VehicleUsePolicy[]

  @@index([tenantId])
  @@map("geofences")
}

enum ManualGpsConfirmationStatus {
  PENDING
  APPROVED
  DENIED
}

// Mirrors ManualFacialVerificationFallback exactly (GPS-002) — office staff
// request/record manual confirmation of a vehicle's location/status when the
// (mock) GPS provider is offline or unavailable; a supervisor resolves it,
// hard self-approval rule enforced the same unconditional way.
model ManualGpsConfirmation {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  reason              String
  positionDescription String

  status ManualGpsConfirmationStatus @default(PENDING)

  requestedByUserId String
  requestedBy       User     @relation("ManualGpsConfirmationRequestedBy", fields: [requestedByUserId], references: [id])
  requestedAt       DateTime @default(now())

  approvedByUserId String?
  approvedBy       User?     @relation("ManualGpsConfirmationApprovedBy", fields: [approvedByUserId], references: [id])
  resolvedAt       DateTime?
  resolutionNotes  String?

  @@index([tenantId])
  @@index([tenantId, vehicleId])
  @@map("manual_gps_confirmations")
}

enum VehicleUsePolicyStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED
}

// POLICY-001 full field list. A policy is authored against a named
// driver/rep and one or more vehicles (VehicleUsePolicyVehicle join table —
// "assigned vehicle(s)", plural). Violations are evaluated by
// lib/telematics/geofence-engine.ts and raise an Exception
// (vehicleId-linked, gateEventId null — see D-020), never an automatic
// allegation (POLICY-002).
model VehicleUsePolicy {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name String

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  // 0 (Sunday) .. 6 (Saturday). Empty array = every day permitted.
  permittedDaysOfWeek Int[]
  // "HH:MM" 24-hour, tenant-local time. Both null = no time-of-day
  // restriction (only permittedDaysOfWeek applies, if set).
  permittedStartTime  String?
  permittedEndTime    String?

  approvedDestination String?
  approvedGeofenceId  String?
  approvedGeofence    Geofence? @relation(fields: [approvedGeofenceId], references: [id])

  kmLimitPerTrip  Float?
  kmLimitPerDay   Float?
  kmLimitPerWeek  Float?
  kmLimitPerMonth Float?

  allowAfterHours         Boolean @default(false)
  allowWeekend            Boolean @default(false)
  allowPrivateUse         Boolean @default(false)
  privateUseKmAllowanceKm Float?

  // "HH:MM" 24-hour, tenant-local time — expected time back on any permitted day.
  expectedReturnTime String?

  approvingManagerUserId String?
  approvingManager       User?   @relation("VehicleUsePolicyApprovingManager", fields: [approvingManagerUserId], references: [id])

  status         VehicleUsePolicyStatus @default(DRAFT)
  overrideReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles               VehicleUsePolicyVehicle[]
  movementAuthorisations MovementAuthorisation[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("vehicle_use_policies")
}

// Many-to-many: one policy can cover several vehicles (e.g. a sales team's
// pool), and — less commonly — a vehicle could be in scope for more than one
// policy over its life (a superseding policy takes over, the old one moves
// to EXPIRED rather than being deleted, append-only spirit).
model VehicleUsePolicyVehicle {
  id        String           @id @default(cuid())
  policyId  String
  policy    VehicleUsePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  vehicleId String
  vehicle   Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([policyId, vehicleId])
  @@map("vehicle_use_policy_vehicles")
}

// ---------------------------------------------------------------------------
// Phase 7 — Platform support-access view. See PRODUCT_REQUIREMENTS.md
// SUPPORT-001..004 and ARCHITECTURE.md "Platform support-access architecture".
// Deliberately a new, separately-scoped, fully audited mechanism — not an
// extension of platform-tenant-repository.ts (D-005/D-016) — for reading a
// customer tenant's data as platform staff. Read-only summary by default;
// "elevated" only records intent/audit trail in this phase (see D-021), it
// does not itself unlock write access to arbitrary customer resources.
// ---------------------------------------------------------------------------

// One time-limited, fully audited grant for one platform-tenant user to view
// one customer tenant's support-view summary (SUPPORT-002/003). Not the same
// thing as a Session (that's the actor's own login) — this is a *permission
// window* layered on top of an already-authenticated platform session,
// checked explicitly by support-access-repository.ts, never by widening
// hasPermission()'s normal per-tenant check.
model SupportAccessSession {
  id       String @id @default(cuid())
  // The actor's own (platform) tenant — kept for the same "every tenant-owned
  // row carries tenantId" convention as everywhere else, even though the
  // *subject* of this row is a different tenant entirely (customerTenantId).
  tenantId String
  tenant   Tenant @relation("SupportAccessSessionActorTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  actorUserId String
  actor       User   @relation("SupportAccessSessionActor", fields: [actorUserId], references: [id])

  customerTenantId String
  customerTenant   Tenant @relation("SupportAccessSessionCustomerTenant", fields: [customerTenantId], references: [id], onDelete: Cascade)

  // Mandatory — SUPPORT-003 "mandatory reason". ticketReference is optional
  // (not every support touch has a formal ticket).
  reason          String
  ticketReference String?

  // SUPPORT-003 "explicit elevated-access workflow for authorised changes" —
  // a second, deliberate action distinct from starting the session at all.
  elevated       Boolean   @default(false)
  elevatedReason String?
  elevatedAt     DateTime?

  startedAt DateTime  @default(now())
  expiresAt DateTime
  // Set on explicit exit (SUPPORT-003 "immediate exit action") — distinct
  // from simply reaching expiresAt, so audit history can tell apart "actor
  // left deliberately" from "actor forgot and it timed out."
  endedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([actorUserId])
  @@index([customerTenantId])
  @@map("support_access_sessions")
}

// A support note is deliberately its own append-only log, not a single
// mutable Tenant field — same "don't rewrite history" principle as AuditLog.
model SupportNote {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation("SupportNoteAuthorTenant", fields: [tenantId], references: [id], onDelete: Cascade)

  customerTenantId String
  customerTenant   Tenant @relation("SupportNoteCustomerTenant", fields: [customerTenantId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation("SupportNoteAuthor", fields: [authorUserId], references: [id])

  note String

  createdAt DateTime @default(now())

  @@index([customerTenantId])
  @@map("support_notes")
}

// ---------------------------------------------------------------------------
// Phase 8C — Retention, archive and deletion. See PRODUCT_REQUIREMENTS.md
// RETAIN-001..010 and ARCHITECTURE.md "Retention architecture". Replaces the
// single tenant-wide Tenant.retentionDays assumption with per-category
// policies; deletion requires a second, different, authorised user
// (dual-control, same hard-rule pattern as D-008/D-020) and a 30-day
// recovery window before anything is permanently removed.
// ---------------------------------------------------------------------------

enum RetentionAssetStatus {
  ACTIVE
  ARCHIVED
  PENDING_DELETION
  DELETED
}

enum DeletionRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_RECOVERY
  COMPLETED
  CANCELLED
}

enum ExportRequestStatus {
  PENDING
  READY
  FAILED
  EXPIRED
}

// Tenant + category-scoped retention rule. Falls back to a hardcoded
// 12-month (365-day) default (lib/retention/policy-repository.ts
// DEFAULT_RETENTION_DAYS) when no row exists for a given category — a
// tenant only needs a row here to *override* the default, not to have one
// at all times.
model RetentionPolicy {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category MediaCategory

  retentionDays                 Int     @default(365)
  includedStorageAllowanceBytes Float?
  archiveEligible               Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, category])
  @@index([tenantId])
  @@map("retention_policies")
}

// A batch deletion request scoped by category/date-range, not a single
// asset — matches the deletion-certificate requirement of recording
// "categories, date range, volume" as one unit. Company Administrator
// initiates (status starts PENDING_APPROVAL); a *different* authorised user
// approves or rejects (hard rule, lib/retention/deletion-repository.ts,
// same "raiser cannot be resolver" family as D-008/D-020) before anything
// enters the 30-day recovery window.
model DeletionRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categories     MediaCategory[]
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?

  status DeletionRequestStatus @default(PENDING_APPROVAL)

  initiatedByUserId String
  initiatedBy       User     @relation("DeletionRequestInitiatedBy", fields: [initiatedByUserId], references: [id])
  initiatedAt       DateTime @default(now())

  approvedByUserId String?
  approvedBy       User?     @relation("DeletionRequestApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?

  rejectedByUserId String?
  rejectedBy       User?     @relation("DeletionRequestRejectedBy", fields: [rejectedByUserId], references: [id])
  rejectedAt       DateTime?
  rejectionReason  String?

  recoveryDays      Int       @default(30)
  recoveryExpiresAt DateTime?
  completedAt       DateTime?

  // Snapshotted at approval time (how many assets/how many bytes this
  // request actually covered) — the certificate reports these even after
  // the underlying MediaAsset rows' own bytes are gone.
  assetCount Int?
  totalBytes Float?

  assets      DeletionRequestAsset[]
  certificate DeletionCertificate?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("deletion_requests")
}

// Snapshot of exactly which MediaAsset rows this request covers, captured at
// initiation time — so a new upload matching the same category/date-range
// filter after the request was submitted is never silently swept in.
model DeletionRequestAsset {
  id                String          @id @default(cuid())
  deletionRequestId String
  deletionRequest   DeletionRequest @relation(fields: [deletionRequestId], references: [id], onDelete: Cascade)
  mediaAssetId      String
  mediaAsset        MediaAsset      @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@unique([deletionRequestId, mediaAssetId])
  @@map("deletion_request_assets")
}

// Issued once a DeletionRequest's recovery window elapses and permanent
// deletion actually runs. Immutable by convention (no update path in
// application code — same append-only spirit as AuditLog, not backed by a
// DB trigger in this pass). "Never claim deleted binary evidence can be
// recovered after permanent deletion" (ARCHITECTURE.md) — this certificate,
// plus the surviving MediaAsset metadata rows, is the only trace that
// remains.
model DeletionCertificate {
  id                String          @id @default(cuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deletionRequestId String          @unique
  deletionRequest   DeletionRequest @relation(fields: [deletionRequestId], references: [id], onDelete: Cascade)

  categories     MediaCategory[]
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?
  assetCount     Int
  totalBytes     Float

  initiatedByUserId String
  approvedByUserId  String

  // One entry per deleted asset: { mediaAssetId, fileName, checksumSha256 }
  // — the "checksum manifest" proving exactly what was deleted, computed
  // from each asset's own recorded checksum before its binary was removed.
  checksumManifest Json

  issuedAt DateTime @default(now())

  @@map("deletion_certificates")
}

// "Export and then delete" (one of the four customer retention choices).
// Deliberately a signed manifest of the matching evidence (metadata +
// per-file expiring signed download links), not a server-generated zip
// archive — avoids adding a heavy archive-generation dependency/pipeline
// for a batch that could be very large, while still giving the customer a
// complete, checksum-verifiable export before deletion proceeds.
model ExportRequest {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  categories     MediaCategory[]
  dateRangeStart DateTime?
  dateRangeEnd   DateTime?

  status ExportRequestStatus @default(PENDING)

  requestedByUserId String
  requestedBy       User     @relation("ExportRequestRequestedBy", fields: [requestedByUserId], references: [id])
  requestedAt       DateTime @default(now())

  // { assets: [{ mediaAssetId, fileName, category, checksumSha256, fileSizeBytes, signedUrl }], generatedAt }
  manifest  Json?
  expiresAt DateTime?

  assetCount Int?
  totalBytes Float?

  @@index([tenantId])
  @@map("export_requests")
}

// ---------------------------------------------------------------------------
// Phase 8E-003 — retention-expiry notifications. Tracks exactly which
// (mediaAssetId, milestone, scheduledDeletionAt) combination has already been
// generated/delivered, so a scheduler that runs generation more than once
// (or re-runs after a crash) can never send the same "90 days left" notice
// twice for the same asset against the same deletion date. If the date
// itself changes (an extension, or a hold-driven recompute), that's a new
// combination and a fresh notice is allowed — this is deliberate, not a gap:
// the customer's actionable date genuinely changed.
//
// Grouped into one outbound message per (tenant, category, milestone) at
// delivery time (lib/repositories/retention-notification-repository.ts) —
// one row per asset here for precise idempotency bookkeeping, but nobody
// receives 500 separate emails for 500 assets crossing the same milestone
// on the same day.
// ---------------------------------------------------------------------------

enum RetentionNotificationStatus {
  PENDING
  SENT
  FAILED
}

enum RetentionNotificationChannel {
  DEV_CONSOLE
  NOOP
  EMAIL
}

model RetentionNotificationRecord {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  // 90 | 60 | 30 | 7 | 0 days-until-expiry — see RetentionNotificationMilestone in lib/retention/deletion-rules.ts.
  milestone           Int
  scheduledDeletionAt DateTime

  status        RetentionNotificationStatus   @default(PENDING)
  // Null until a delivery attempt actually runs — which provider handled
  // it isn't known at generation time, only at attempt time.
  channel       RetentionNotificationChannel?
  attemptedAt   DateTime?
  deliveredAt   DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  @@unique([mediaAssetId, milestone, scheduledDeletionAt])
  @@index([tenantId])
  @@index([status])
  @@map("retention_notification_records")
}

// ---------------------------------------------------------------------------
// Phase 8E-004 — background job architecture. Cross-tenant system-job
// bookkeeping, deliberately NOT an AuditLog row: JobRun tracks *system*
// process execution (did the notification-generation sweep run, did it
// succeed), not a tenant-scoped business action a human took, so it carries
// no tenantId and no append-only guarantee.
//
// Concurrency protection is a hard DB guarantee, not a best-effort
// check-then-insert race: a partial unique index (applied via this model's
// own migration SQL — Prisma's schema DSL has no `WHERE` clause for
// `@@unique`) enforces at most one RUNNING row per jobName at any time.
// Two overlapping invocations of the same job therefore collide on a real
// Postgres unique-constraint violation (see lib/jobs/run-job.ts,
// JobAlreadyRunningError), not a race window between two application-level
// checks.
// ---------------------------------------------------------------------------

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

model JobRun {
  id      String       @id @default(cuid())
  jobName String
  status  JobRunStatus @default(RUNNING)

  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  resultSummary Json?
  errorMessage  String?

  @@index([jobName, startedAt])
  @@map("job_runs")
}

// ---------------------------------------------------------------------------
// Phase 10 — Subscriptions, Billing and Invoicing (PRODUCT_REQUIREMENTS.md
// P10A-P10P). See BILLING_AND_SUBSCRIPTIONS.md for the full commercial
// model. All money fields are integer minor currency units (e.g. ZAR cents)
// — never a JS float, per the approved commercial-model instruction. VAT
// rates are integer basis points for the same reason. Pricing is
// append-only/versioned: PlatformPricingVersion and TenantPricingAgreement
// rows are never edited or deleted, only superseded by a newer row, so an
// already-issued Invoice's snapshot fields remain historically accurate
// even after prices, vehicle counts, or addresses later change (D-035).
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentMethod {
  PROVIDER
  MANUAL
}

enum InvoiceLineItemKind {
  BASE_FEE
  VEHICLE_FEE
  ARCHIVE_STORAGE
  ADJUSTMENT
  OTHER
}

enum BillingPeriodStatus {
  PENDING
  SNAPSHOTTED
  INVOICED
}

enum BillingEmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum BillingEmailTriggerEvent {
  PAYMENT_SUCCESS
  MANUAL_APPROVAL
  RESEND
}

enum PaymentProviderEventResult {
  ACCEPTED
  REJECTED_INVALID_SIGNATURE
  REJECTED_AMOUNT_MISMATCH
  REJECTED_CURRENCY_MISMATCH
  DUPLICATE
  ERROR
}

// Platform-wide (not tenant-scoped) named commercial plan container. V1
// seeds exactly one plan ("Standard") — the model exists so a future
// multi-plan offering doesn't require a schema migration.
model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  currency    String   @default("ZAR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenantSubscriptions TenantSubscription[]

  @@map("subscription_plans")
}

// Append-only — a new row is added whenever the platform's own default
// pricing changes; never edited or deleted (D-035). The current default
// price is the row with the latest effectiveFrom <= now.
model PlatformPricingVersion {
  id                      String   @id @default(cuid())
  baseFeeMinorUnits       Int
  perVehicleFeeMinorUnits Int
  currency                String   @default("ZAR")
  effectiveFrom           DateTime @default(now())
  note                    String?
  createdByUserId         String?
  createdBy               User?    @relation("PlatformPricingVersionCreatedBy", fields: [createdByUserId], references: [id])
  createdAt               DateTime @default(now())

  @@index([effectiveFrom])
  @@map("platform_pricing_versions")
}

// Singleton row (fixed id "platform") — legal/trading identity, invoice
// numbering, VAT configuration, and platform-wide billing defaults (P10B).
// Managed exclusively by Platform Administrator; ordinary client users
// (even Company Administrator) can never edit this.
model PlatformBillingSettings {
  id                             String   @id @default("platform")
  legalName                      String   @default("")
  tradingName                    String?
  registrationNumber             String?
  vatRegistrationNumber          String?
  vatEnabled                     Boolean  @default(false)
  // Integer basis points (1/100th of a percent), e.g. 1500 = 15.00%.
  vatRateBasisPoints             Int?
  addressLine1                   String?
  addressLine2                   String?
  city                           String?
  postalCode                     String?
  country                        String   @default("South Africa")
  billingEmail                   String?
  telephone                      String?
  bankingInstructions            String?
  invoicePrefix                  String   @default("INV")
  nextInvoiceSequence            Int      @default(1)
  currency                       String   @default("ZAR")
  defaultPaymentTermsDays        Int      @default(30)
  defaultGracePeriodDays         Int      @default(14)
  defaultBaseFeeMinorUnits       Int      @default(199900)
  defaultPerVehicleFeeMinorUnits Int      @default(29900)
  updatedAt                      DateTime @updatedAt
  updatedByUserId                String?
  updatedBy                      User?    @relation("PlatformBillingSettingsUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("platform_billing_settings")
}

// Tenant-scoped commercial/contact/registration details (P10C). Deliberately
// does not store negotiated fee amounts directly — those are append-only
// versioned rows on TenantPricingAgreement (D-035) so an issued invoice's
// historical price is never affected by a later negotiation.
model TenantBillingProfile {
  id                     String    @id @default(cuid())
  tenantId               String    @unique
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registeredBusinessName String?
  tradingName            String?
  registrationNumber     String?
  vatNumber              String?
  billingAddressLine1    String?
  billingAddressLine2    String?
  billingCity            String?
  billingPostalCode      String?
  billingCountry         String    @default("South Africa")
  billingEmail           String?
  accountsContactName    String?
  accountsContactEmail   String?
  accountsContactPhone   String?
  poRequired             Boolean   @default(false)
  customerReference      String?
  paymentTermsDays       Int?
  gracePeriodDays        Int?
  subscriptionStartDate  DateTime?
  notes                  String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@map("tenant_billing_profiles")
}

// Additional billing-email recipients beyond TenantBillingProfile's single
// accountsContactEmail — invoice email delivery (P10H) fans out to every
// active row here plus the profile's own accountsContactEmail/billingEmail.
model CustomerBillingContact {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String?
  email     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("customer_billing_contacts")
}

// Append-only tenant-specific negotiated pricing (P10A/B — "a tenant may
// have a negotiated base fee or per-vehicle fee"). Never edited or deleted;
// the current agreement is the row with the latest effectiveFrom <= now.
// When no row exists for a tenant, PlatformBillingSettings' defaults apply.
model TenantPricingAgreement {
  id                      String   @id @default(cuid())
  tenantId                String
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseFeeMinorUnits       Int
  perVehicleFeeMinorUnits Int
  currency                String   @default("ZAR")
  effectiveFrom           DateTime @default(now())
  note                    String?
  createdByUserId         String?
  createdBy               User?    @relation("TenantPricingAgreementCreatedBy", fields: [createdByUserId], references: [id])
  createdAt               DateTime @default(now())

  @@index([tenantId, effectiveFrom])
  @@map("tenant_pricing_agreements")
}

// One row per tenant — subscription lifecycle state, distinct from the
// legacy Tenant.subscriptionStatus manual flag (Phase 7), kept unchanged for
// backward compatibility of the existing SUPPORT-001 health summary — see
// D-035 for why this is a new model rather than repurposing that field.
model TenantSubscription {
  id                String             @id @default(cuid())
  tenantId          String             @unique
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId            String
  plan              SubscriptionPlan   @relation(fields: [planId], references: [id])
  status            SubscriptionStatus @default(PENDING)
  startedAt         DateTime?
  // Null actor = an automated suspension/restoration (P10K "automated
  // suspension behind a configurable, tested policy") rather than a human
  // platform-admin action — both are equally audited (see recordAudit()
  // call sites in tenant-subscription-repository.ts), this only
  // distinguishes who/what performed it.
  suspendedAt       DateTime?
  suspendedReason   String?
  suspendedByUserId String?
  suspendedBy       User?              @relation("TenantSubscriptionSuspendedBy", fields: [suspendedByUserId], references: [id])
  restoredAt        DateTime?
  restoredByUserId  String?
  restoredBy        User?              @relation("TenantSubscriptionRestoredBy", fields: [restoredByUserId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("tenant_subscriptions")
}

// One row per tenant per calendar month — the anchor billing cycle
// (P10D/P10L). A hard uniqueness constraint prevents the recurring job (or
// a manual retry) from ever creating two periods for the same tenant+month.
model BillingPeriod {
  id          String              @id @default(cuid())
  tenantId    String
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  status      BillingPeriodStatus @default(PENDING)
  createdAt   DateTime            @default(now())

  billableVehicleSnapshot BillableVehicleSnapshot?
  invoice                 Invoice?

  @@unique([tenantId, periodStart])
  @@map("billing_periods")
}

// Deterministic, immutable-once-created monthly billing snapshot (P10D).
// Exact vehicle IDs/count and the price actually applied are recorded here
// so a later vehicle activation/deactivation or price change can never
// rewrite what an already-generated invoice was based on.
model BillableVehicleSnapshot {
  id                             String        @id @default(cuid())
  tenantId                       String
  tenant                         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingPeriodId                String        @unique
  billingPeriod                  BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  vehicleIds                     String[]
  vehicleCount                   Int
  baseFeeMinorUnitsApplied       Int
  perVehicleFeeMinorUnitsApplied Int
  currency                       String        @default("ZAR")
  generatedAt                    DateTime      @default(now())
  generatedByUserId              String?
  generatedBy                    User?         @relation("BillableVehicleSnapshotGeneratedBy", fields: [generatedByUserId], references: [id])

  @@map("billable_vehicle_snapshots")
}

model Invoice {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  billingPeriodId String?        @unique
  billingPeriod   BillingPeriod? @relation(fields: [billingPeriodId], references: [id])
  invoiceNumber   String         @unique
  status          InvoiceStatus  @default(DRAFT)
  issueDate       DateTime       @default(now())
  dueDate         DateTime
  currency        String         @default("ZAR")

  subtotalMinorUnits  Int
  vatRateBasisPoints  Int?
  vatAmountMinorUnits Int  @default(0)
  totalMinorUnits     Int

  // Immutable snapshots of supplier/customer identity at issue time (D-035)
  // — an issued invoice must remain historically accurate even if the
  // tenant's billing profile or the platform's own registration details
  // change later. Shape documented in BILLING_AND_SUBSCRIPTIONS.md.
  supplierSnapshot Json
  customerSnapshot Json

  customerPoReference String?
  paymentReference    String?

  pdfMediaAssetId String?     @unique
  pdfMediaAsset   MediaAsset? @relation("InvoicePdf", fields: [pdfMediaAssetId], references: [id])

  voidedAt       DateTime?
  voidedByUserId String?
  voidedBy       User?     @relation("InvoiceVoidedBy", fields: [voidedByUserId], references: [id])
  voidReason     String?

  // Self-relation lineage for a controlled reissue (P10E "no silent
  // regeneration — a controlled void/reissue/adjustment process with an
  // audit trail"): the new invoice points back at the one it replaces.
  reissueOfInvoiceId String?  @unique
  reissueOfInvoice   Invoice? @relation("InvoiceReissue", fields: [reissueOfInvoiceId], references: [id])
  reissuedByInvoice  Invoice? @relation("InvoiceReissue")

  // Null = generated by the automated recurring billing job (P10L);
  // non-null = a platform admin generated/regenerated it manually.
  createdByUserId String?
  createdBy       User?    @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  lineItems              InvoiceLineItem[]
  payments               Payment[]
  paymentAttempts        PaymentAttempt[]
  billingEmailDeliveries BillingEmailDelivery[]
  creditAdjustments      CreditAdjustment[]

  @@index([tenantId, status])
  @@map("invoices")
}

model InvoiceLineItem {
  id                  String              @id @default(cuid())
  invoiceId           String
  invoice             Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind                InvoiceLineItemKind
  description         String
  quantity            Int                 @default(1)
  unitPriceMinorUnits Int
  lineTotalMinorUnits Int
  sortOrder           Int                 @default(0)

  @@map("invoice_line_items")
}

model Payment {
  id               String        @id @default(cuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountMinorUnits Int
  currency         String        @default("ZAR")
  status           PaymentStatus @default(PENDING)
  method           PaymentMethod

  providerName      String?
  providerReference String?

  // Guarantees a genuine retry (same key) never creates a second Payment row
  // — the idempotency boundary this model exists to enforce (P10G).
  idempotencyKey String @unique

  // Set only for method: MANUAL — an authorised platform finance user's own
  // proof/reference for a payment received outside the payment provider
  // (e.g. an EFT reference), enforced at the application layer (never a
  // card number, CVV, or online-banking credential — P10G).
  recordedByUserId     String?
  recordedBy           User?   @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id])
  manualProofReference String?
  manualNote           String?

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  billingEmailDeliveries BillingEmailDelivery[]

  @@index([tenantId, invoiceId])
  @@map("payments")
}

// A payment-provider checkout/session in flight, before it resolves to a
// confirmed Payment (P10F/G) — e.g. MockPaymentProvider's synthetic
// checkout session.
model PaymentAttempt {
  id                String        @id @default(cuid())
  tenantId          String
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId         String
  invoice           Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider          String
  status            PaymentStatus @default(PENDING)
  checkoutReference String?
  idempotencyKey    String        @unique
  resolvedPaymentId String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([tenantId, invoiceId])
  @@map("payment_attempts")
}

// Inbound payment-provider webhook/event records (P10G). tenantId/invoiceId
// are resolved from the provider's own reference and nullable until that
// resolution succeeds. The (provider, externalEventId) uniqueness
// constraint is the hard duplicate-webhook-processing guarantee — a second
// delivery of the same event collides on a real Postgres constraint, not a
// best-effort check.
model PaymentProviderEvent {
  id               String                      @id @default(cuid())
  provider         String
  externalEventId  String
  eventType        String
  tenantId         String?
  invoiceId        String?
  payload          Json
  processingResult PaymentProviderEventResult?
  processedAt      DateTime?
  createdAt        DateTime                    @default(now())

  @@unique([provider, externalEventId])
  @@map("payment_provider_events")
}

// One row per invoice-email delivery attempt (P10H). A partial unique index
// (applied via this model's own migration SQL, same pattern as JobRun/
// DriverFacialTemplate — Prisma's @@unique has no WHERE clause) enforces at
// most one PAYMENT_SUCCESS-or-MANUAL_APPROVAL delivery per
// (invoiceId, relatedPaymentId) — duplicate webhooks/approvals can never
// send the invoice email twice. A RESEND is a deliberate new row every time.
model BillingEmailDelivery {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  invoiceId        String
  invoice          Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  relatedPaymentId String?
  relatedPayment   Payment? @relation(fields: [relatedPaymentId], references: [id])

  recipientEmail String
  status         BillingEmailDeliveryStatus @default(PENDING)
  triggerEvent   BillingEmailTriggerEvent

  triggeredByUserId String?
  triggeredBy       User?   @relation("BillingEmailDeliveryTriggeredBy", fields: [triggeredByUserId], references: [id])

  provider     String
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([tenantId, invoiceId])
  @@map("billing_email_deliveries")
}

// A manual credit or debit adjustment against a tenant's billing (P10A) —
// always a deliberate, audited, human-initiated correction (e.g. a
// goodwill credit, or a correction line to include on the next invoice).
model CreditAdjustment {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId        String?
  invoice          Invoice? @relation(fields: [invoiceId], references: [id])
  amountMinorUnits Int
  currency         String   @default("ZAR")
  reason           String
  createdByUserId  String
  createdBy        User     @relation("CreditAdjustmentCreatedBy", fields: [createdByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@map("credit_adjustments")
}

// ===========================================================================
// Phase 11: Investigation, Internal Review and External Audit Case Management
// See INVESTIGATIONS_AND_EXTERNAL_AUDIT.md for the full workflow narrative.
// ===========================================================================

enum InvestigationSource {
  GATE_EXCEPTION
  FACIAL_VERIFICATION_FAILURE
  VEHICLE_INSPECTION_FAILURE
  CARGO_LOAD_DISCREPANCY
  RECONCILIATION_DISCREPANCY
  GPS_GEOFENCE_EXCEPTION
  MISSING_EVIDENCE
  SUSPECTED_UNAUTHORISED_USE
  ODOMETER_FUEL_CONDITION_DISCREPANCY
  MANUAL_CONCERN
  OTHER
}

// Kept as a small fixed enum (rather than a free-text/tenant-configurable
// catalogue like ExceptionType) so Phase 12 can aggregate by category
// without a redesign (P11P) — extend this list only, never repurpose a value.
enum InvestigationCategory {
  FRAUD
  THEFT
  SAFETY
  POLICY_VIOLATION
  MISCONDUCT
  DATA_INTEGRITY
  UNAUTHORISED_USE
  OTHER
}

enum InvestigationStatus {
  DRAFT
  OPEN
  TRIAGE
  UNDER_INVESTIGATION
  AWAITING_INFORMATION
  AWAITING_APPROVAL
  CLOSED
  REOPENED
}

// Deliberately separate from InvestigationStatus (P11A hard requirement) —
// outcome must never be inferred from status alone, and NOT_DETERMINED is
// the only valid outcome for every non-CLOSED case.
enum InvestigationOutcome {
  NOT_DETERMINED
  SUBSTANTIATED
  UNSUBSTANTIATED
  INCONCLUSIVE
  REFERRED_FOR_FURTHER_ACTION
}

enum InvestigationConfidentiality {
  STANDARD
  RESTRICTED
  HIGHLY_RESTRICTED
}

// A subject is a linked party, never a verdict — the interface must always
// render this as "case subject", never "suspect"/"guilty" (P11A/E hard rule).
enum InvestigationPartyRole {
  SUBJECT
  WITNESS
  OTHER_INVOLVED_PARTY
}

enum InvestigationRelatedRecordType {
  EXCEPTION
  GATE_EVENT
  GATE_EVENT_INSPECTION_ITEM
  MOVEMENT_AUTHORISATION
  RECONCILIATION
  RECONCILIATION_DISCREPANCY
  FACIAL_VERIFICATION_ATTEMPT
  TELEMATICS_EVENT
  VEHICLE
  DRIVER
  OTHER
}

enum InvestigationNoteType {
  GENERAL
  INTERVIEW
  ANALYSIS
  DECISION
  SYSTEM
}

enum InvestigationTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum InvestigationFindingStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED_FOR_AMENDMENT
  REJECTED
}

enum InvestigationApprovalAction {
  SUBMIT
  APPROVE
  RETURN_FOR_AMENDMENT
  REJECT
}

// One settings row per tenant (P11C/D/G). casePrefix is the configurable
// prefix used by allocateNextInvestigationCaseNumber()
// (investigation-repository.ts); enforceSeparationOfDuties and
// requireDualApprovalForHighSeverityHoldRelease are the two configurable
// safety policies P11D/P11G ask for — see investigation-repository.ts /
// investigation-hold-repository.ts for how each is actually enforced.
model TenantInvestigationSettings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  casePrefix                                    String  @default("INV")
  enforceSeparationOfDuties                     Boolean @default(true)
  requireDualApprovalForHighSeverityHoldRelease Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_investigation_settings")
}

// One row per (tenant, year). nextSequence is allocated via a single atomic
// Prisma upsert (native Postgres INSERT ... ON CONFLICT DO UPDATE ...
// RETURNING), the same atomicity guarantee as
// PlatformBillingSettings.nextInvoiceSequence, so two concurrent
// case-creation calls in the same tenant/year can never receive the same
// number (P11C). Historical case numbers never change even if casePrefix is
// later reconfigured — only the sequence portion is derived from this table.
model InvestigationCaseSequence {
  id           String @id @default(cuid())
  tenantId     String
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  year         Int
  nextSequence Int    @default(1)

  @@unique([tenantId, year])
  @@map("investigation_case_sequences")
}

model InvestigationCase {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // e.g. "INV-2026-000001" — see allocateNextInvestigationCaseNumber().
  caseNumber String

  // Present only while a referral-sourced case is open. The tenant/type/id
  // composite value is globally unique and makes referral de-duplication
  // race-safe; closure clears it so a later referral may create a new case.
  activeReferralKey String? @unique

  title       String
  // The allegation/description as originally reported — kept separate from
  // verified findings (InvestigationFinding) so nothing in this record
  // implies an allegation is a proven fact merely because a case exists.
  description String

  source   InvestigationSource
  category InvestigationCategory?
  // Reuses ExceptionSeverity rather than a duplicate enum — same LOW/MEDIUM/
  // HIGH/CRITICAL scale already used for exceptions and reconciliation
  // discrepancies, several of which are common referral sources for a case.
  priority ExceptionSeverity      @default(MEDIUM)

  status  InvestigationStatus  @default(DRAFT)
  outcome InvestigationOutcome @default(NOT_DETERMINED)

  confidentiality InvestigationConfidentiality @default(STANDARD)

  reportingPersonUserId String?
  reportingPerson       User?   @relation("InvestigationCaseReportingPerson", fields: [reportingPersonUserId], references: [id])
  // Free text — the reporter may not be a system user (e.g. an anonymous or
  // external report), so this is never required to resolve to a User row.
  reportingPersonName   String?

  assignedInvestigatorUserId String?
  assignedInvestigator       User?   @relation("InvestigationCaseAssignedInvestigator", fields: [assignedInvestigatorUserId], references: [id])

  caseOwnerUserId String
  caseOwner       User   @relation("InvestigationCaseOwner", fields: [caseOwnerUserId], references: [id])

  createdByUserId String
  createdBy       User   @relation("InvestigationCaseCreatedBy", fields: [createdByUserId], references: [id])

  submittedAt DateTime?
  triagedAt   DateTime?

  // Closure requires all four of these to be set together, enforced in
  // closeInvestigationCase() — never independently (P11D hard requirement).
  // The "finding summary" itself is the approved InvestigationFinding's
  // executiveSummary, not duplicated onto the case row.
  closedAt       DateTime?
  closedByUserId String?
  closedBy       User?     @relation("InvestigationCaseClosedBy", fields: [closedByUserId], references: [id])

  reopenedAt       DateTime?
  reopenedByUserId String?
  reopenedBy       User?     @relation("InvestigationCaseReopenedBy", fields: [reopenedByUserId], references: [id])
  reopenReason     String?

  // Investigation hold on the case as a whole (as distinct from the
  // per-evidence MediaAsset.investigationHold flag it drives) — set true
  // automatically when a qualifying case opens (P11G) and only ever released
  // by an authorised, reasoned, audited action; closing a case does NOT
  // auto-release this (P11G hard requirement).
  evidenceHoldActive           Boolean   @default(true)
  evidenceHoldReleasedAt       DateTime?
  evidenceHoldReleasedByUserId String?
  evidenceHoldReleasedBy       User?     @relation("InvestigationCaseHoldReleasedBy", fields: [evidenceHoldReleasedByUserId], references: [id])
  evidenceHoldReleaseReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects                 InvestigationSubject[]
  relatedRecords           InvestigationRelatedRecord[]
  notes                    InvestigationNote[]
  tasks                    InvestigationTask[]
  findings                 InvestigationFinding[]
  approvals                InvestigationApproval[]
  evidenceLinks            InvestigationEvidenceLink[]
  chronologyEvents         InvestigationChronologyEvent[]
  externalAccessGrantCases ExternalAuditorAccessGrantCase[]
  externalAccessLogs       ExternalAuditorAccessLog[]
  notificationRecords      InvestigationNotificationRecord[]

  @@unique([tenantId, caseNumber])
  @@index([tenantId, status])
  @@index([tenantId, assignedInvestigatorUserId])
  @@map("investigation_cases")
}

// An involved party linked to a case. Deliberately never described as
// "suspect" anywhere in code/comments/interface — see InvestigationPartyRole.
model InvestigationSubject {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  role InvestigationPartyRole

  userId    String?
  user      User?    @relation("InvestigationSubjectUser", fields: [userId], references: [id])
  driverId  String?
  driver    Driver?  @relation(fields: [driverId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  contractorName String?
  department     String?
  site           String?

  notes String?

  // The subject's own account/response, stored separately from findings so
  // it is never silently dropped from the record (P11E).
  explanationResponse    String?
  explanationRespondedAt DateTime?

  createdByUserId String
  createdBy       User     @relation("InvestigationSubjectCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([tenantId, caseId])
  @@index([userId])
  @@index([driverId])
  @@index([vehicleId])
  @@map("investigation_subjects")
}

// Links a case to an existing operational record WITHOUT copying its
// mutable data: recordType/recordId is a polymorphic pointer (same pattern
// as MediaAsset.(ownerType, ownerId) / AuditLog.(entityType, entityId)), and
// snapshotSummary is an immutable, point-in-time display snapshot captured
// only for read convenience — linking a record never modifies it (P11B hard
// requirement: opening a case must not silently resolve, approve or alter
// the source record).
model InvestigationRelatedRecord {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  recordType      InvestigationRelatedRecordType
  recordId        String
  snapshotSummary Json

  // True for the single record that triggered this case's creation as a
  // referral — used by investigation-referral-repository.ts to detect and
  // prevent an accidental duplicate referral of the same source record into
  // a second still-open case.
  isReferralSource Boolean @default(false)

  linkedByUserId String
  linkedBy       User     @relation("InvestigationRelatedRecordLinkedBy", fields: [linkedByUserId], references: [id])
  linkedAt       DateTime @default(now())

  @@index([tenantId, recordType, recordId])
  @@index([tenantId, caseId])
  @@map("investigation_related_records")
}

// Append-only. An amendment/correction is always a NEW row with
// supersedesNoteId pointing at the note it corrects — the original row's
// content is never edited or deleted (P11H hard requirement).
model InvestigationNote {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  authorUserId String
  author       User   @relation("InvestigationNoteAuthor", fields: [authorUserId], references: [id])

  noteType        InvestigationNoteType        @default(GENERAL)
  confidentiality InvestigationConfidentiality @default(STANDARD)
  content         String

  supersedesNoteId String?            @unique
  supersedesNote   InvestigationNote? @relation("InvestigationNoteAmendment", fields: [supersedesNoteId], references: [id])
  amendedBy        InvestigationNote? @relation("InvestigationNoteAmendment")

  createdAt DateTime @default(now())

  @@index([tenantId, caseId, createdAt])
  @@map("investigation_notes")
}

model InvestigationTask {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  description      String
  assignedToUserId String
  assignedTo       User                    @relation("InvestigationTaskAssignedTo", fields: [assignedToUserId], references: [id])
  dueDate          DateTime?
  status           InvestigationTaskStatus @default(OPEN)

  completionNote    String?
  completedByUserId String?
  completedBy       User?     @relation("InvestigationTaskCompletedBy", fields: [completedByUserId], references: [id])
  completedAt       DateTime?

  createdByUserId String
  createdBy       User     @relation("InvestigationTaskCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, caseId])
  @@index([tenantId, assignedToUserId, status])
  @@map("investigation_tasks")
}

// One immutable version per submit-approve cycle. A change after approval
// always creates a NEW row with version = previous + 1 and status DRAFT —
// the approved version itself is never edited (P11I hard requirement).
model InvestigationFinding {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  version Int

  executiveSummary       String
  detailedFindings       String
  evidenceRelied         String?
  contradictoryEvidence  String?
  subjectResponseSummary String?
  outcome                InvestigationOutcome
  recommendations        String?
  correctiveActions      String?
  controlWeaknesses      String?
  followUpDate           DateTime?

  status InvestigationFindingStatus @default(DRAFT)

  createdByUserId String
  createdBy       User     @relation("InvestigationFindingCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  submittedByUserId String?
  submittedBy       User?     @relation("InvestigationFindingSubmittedBy", fields: [submittedByUserId], references: [id])
  submittedAt       DateTime?

  approvals InvestigationApproval[]

  @@unique([caseId, version])
  @@index([tenantId, caseId])
  @@map("investigation_findings")
}

// Append-only decision log for a finding's approval workflow — separate
// from InvestigationChronologyEvent so the approval-specific fields
// (action/reason/actor) stay strongly typed rather than living only in a
// Json chronology payload. Separation-of-duties (the same actor may not
// both submit and approve a configured case) is enforced in
// investigation-approval-repository.ts, not by this table's shape alone.
model InvestigationApproval {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  findingId String
  finding   InvestigationFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  action      InvestigationApprovalAction
  actorUserId String
  actor       User                        @relation("InvestigationApprovalActor", fields: [actorUserId], references: [id])
  reason      String?
  createdAt   DateTime                    @default(now())

  @@index([tenantId, caseId])
  @@index([findingId])
  @@map("investigation_approvals")
}

// Links a MediaAsset (reused exactly as-is — no duplicated storage) to a
// case as a numbered evidence item. Append-only: an item added in error is
// marked enteredInError with a reason, never deleted (chain-of-custody
// requirement, P11F). Confidentiality/relevance/hold-status/access-log are
// deliberately not re-implemented here where MediaAsset already carries the
// equivalent field (investigationHold, and the mint-time audit entry from
// mintSignedUrlForMediaAsset serves as the access log).
model InvestigationEvidenceLink {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  evidenceNumber Int

  mediaAssetId String
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id])

  description      String
  sourceRecordType String?
  sourceRecordId   String?
  relevance        String?
  confidentiality  InvestigationConfidentiality @default(STANDARD)

  addedByUserId String
  addedBy       User     @relation("InvestigationEvidenceLinkAddedBy", fields: [addedByUserId], references: [id])
  addedAt       DateTime @default(now())

  enteredInError         Boolean   @default(false)
  enteredInErrorReason   String?
  enteredInErrorByUserId String?
  enteredInErrorBy       User?     @relation("InvestigationEvidenceLinkEnteredInErrorBy", fields: [enteredInErrorByUserId], references: [id])
  enteredInErrorAt       DateTime?

  @@unique([caseId, evidenceNumber])
  @@index([tenantId, caseId])
  @@index([mediaAssetId])
  @@map("investigation_evidence_links")
}

// The case's own full ordered lifecycle timeline, written alongside (not
// instead of) the platform AuditLog by recordInvestigationEvent()
// (investigation-audit.ts), so the UI can show a single case-scoped
// chronology without joining across every sub-entity's own AuditLog rows.
model InvestigationChronologyEvent {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  eventType   String
  description String
  actorUserId String?
  actor       User?    @relation("InvestigationChronologyEventActor", fields: [actorUserId], references: [id])
  metadata    Json?
  occurredAt  DateTime @default(now())

  @@index([tenantId, caseId, occurredAt])
  @@map("investigation_chronology_events")
}

// A dedicated, restricted external-auditor access mechanism (P11L).
// Deliberately NOT SupportAccessSession (that is unrestricted platform-admin
// access to a whole tenant, D-016/D-021) — this grant is scoped to specific
// case IDs only (ExternalAuditorAccessGrantCase), read-only by default
// (canDownloadReport/canDownloadEvidence opt-in), time-limited and
// immediately revocable.
model ExternalAuditorAccessGrant {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  externalAuditorUserId String
  externalAuditor       User   @relation("ExternalAuditorAccessGrantAuditor", fields: [externalAuditorUserId], references: [id])

  grantedByUserId String
  grantedBy       User   @relation("ExternalAuditorAccessGrantGrantedBy", fields: [grantedByUserId], references: [id])
  reason          String

  canDownloadReport   Boolean @default(false)
  canDownloadEvidence Boolean @default(false)

  startAt   DateTime @default(now())
  expiresAt DateTime

  revokedAt       DateTime?
  revokedByUserId String?
  revokedBy       User?     @relation("ExternalAuditorAccessGrantRevokedBy", fields: [revokedByUserId], references: [id])
  revokedReason   String?

  createdAt DateTime @default(now())

  cases      ExternalAuditorAccessGrantCase[]
  accessLogs ExternalAuditorAccessLog[]

  @@index([tenantId, externalAuditorUserId])
  @@map("external_auditor_access_grants")
}

model ExternalAuditorAccessGrantCase {
  id      String                     @id @default(cuid())
  grantId String
  grant   ExternalAuditorAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  caseId  String
  case    InvestigationCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([grantId, caseId])
  @@index([caseId])
  @@map("external_auditor_access_grant_cases")
}

// Every view/download by an external auditor is recorded here (P11L hard
// requirement) — separate from InvestigationChronologyEvent so a
// per-grant auditor-access audit trail can be queried without filtering the
// case's whole internal timeline.
enum InvestigationNotificationEventType {
  ASSIGNMENT
  INFORMATION_REQUESTED
  OVERDUE_TASK
  ESCALATION
  APPROVAL_REQUIRED
  APPROVAL_RETURNED
  APPROVAL_REJECTED
  CLOSURE
  EXTERNAL_ACCESS_GRANTED
  EXTERNAL_ACCESS_EXPIRING
  EXTERNAL_ACCESS_REVOKED
}

enum InvestigationNotificationStatus {
  PENDING
  SENT
  FAILED
}

// One row per investigation-event notification attempt (P11N), same
// "persist the attempt, don't just fire-and-forget" shape as
// RetentionNotificationRecord — failures stay visible (status FAILED +
// failureReason) and are retried on the next
// retryFailedInvestigationNotifications() job run, without ever touching
// the case's own status (P11N hard requirement).
model InvestigationNotificationRecord {
  id       String            @id @default(cuid())
  tenantId String
  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  eventType       InvestigationNotificationEventType
  recipientUserId String
  recipient       User                               @relation("InvestigationNotificationRecipient", fields: [recipientUserId], references: [id])

  status        InvestigationNotificationStatus @default(PENDING)
  channel       String?
  attemptedAt   DateTime?
  deliveredAt   DateTime?
  failureReason String?

  createdAt DateTime @default(now())

  @@index([tenantId, caseId])
  @@index([tenantId, status])
  @@map("investigation_notification_records")
}

model ExternalAuditorAccessLog {
  id       String                     @id @default(cuid())
  tenantId String
  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  grantId  String
  grant    ExternalAuditorAccessGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)
  caseId   String
  case     InvestigationCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  actorUserId String
  actor       User     @relation("ExternalAuditorAccessLogActor", fields: [actorUserId], references: [id])
  action      String
  occurredAt  DateTime @default(now())

  @@index([tenantId, grantId])
  @@index([tenantId, caseId])
  @@map("external_auditor_access_logs")
}
