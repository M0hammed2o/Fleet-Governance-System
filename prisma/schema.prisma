  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  complianceDocuments       ComplianceDocument[]
  tyres                     VehicleTyre[]
  movementAuthorisations    MovementAuthorisation[]   @relation("MovementVehicle")
  trailerForMovements       MovementAuthorisation[]   @relation("MovementTrailer")
  gateEvents                GateEvent[]               @relation("GateEventVehicle")
  trailerForGateEvents      GateEvent[]               @relation("GateEventTrailer")
  telematicsExceptions      Exception[]               @relation("ExceptionVehicle")
  telematicsEvents          TelematicsEvent[]
